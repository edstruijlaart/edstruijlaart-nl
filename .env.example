# edstruijlaart.nl — environment variabelen (VOORBEELD)
#
# Alleen NAMEN + placeholders. Vul de echte waarden NOOIT hier in.
# Productiewaarden staan in het Vercel-projectdashboard (Settings → Environment Variables).
# Lokaal binnenhalen vanuit Vercel:  npx vercel env pull .env
#
# De GitHub-repo is PUBLIC. Zet hier nooit echte secrets in.
# VERPLICHT = de site/funnel breekt zonder.  OPTIONEEL = alleen voor deelfunctionaliteit.

# --- Sanity CMS (show-data, content, blog-images) ---
SANITY_PROJECT_ID=your-sanity-project-id              # VERPLICHT (productie: q407odag)
PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id       # VERPLICHT (fallback voor SANITY_PROJECT_ID)
SANITY_DATASET=production                             # OPTIONEEL (default: production)
SANITY_WRITE_TOKEN=sk_your_sanity_write_token         # VERPLICHT (mutaties: gasten, bootleg, ratings)

# --- E-mail (Resend) ---
RESEND_API_KEY=re_your_resend_api_key                 # VERPLICHT (herinnering/bevestiging/notificaties)

# --- Auth voor API-/cron-endpoints ---
CRON_SECRET=your_long_random_cron_secret              # VERPLICHT (send-reminder cron + manage + rating-HMAC)
BOOTLEG_API_KEY=your_long_random_bootleg_key          # VERPLICHT (bootleg-upload via iOS Shortcut + confirm)

# --- Serenade (externe API + kaart) ---
SERENADE_API_URL=https://serenade.example.com         # OPTIONEEL (alleen /serenade/[editie] + register)
PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key  # OPTIONEEL (kaart op serenade-editiepagina)

# --- Listmonk (nieuwsbrief op de Pi) ---
# LET OP: de website hardcodet de publieke Listmonk-URL en lijst-UUID's in de broncode.
# Deze vars zijn aanwezig voor admin/sync, niet voor de actieve aanmeld-paden.
LISTMONK_URL=https://newsletter.example.com           # OPTIONEEL
LISTMONK_USER=admin                                   # OPTIONEEL
LISTMONK_PASS=your_listmonk_password                  # OPTIONEEL
LISTMONK_HK_LIST_ID=12                                # OPTIONEEL (lijst-id huiskamer)

# --- Overig ---
SITE_URL=https://edstruijlaart.nl                     # OPTIONEEL (basis-URL in lokaal/build-context)
NOTIFY_EMAIL=ed@edstruijlaart.nl                      # OPTIONEEL (ontvanger notificatie-mails)
# SUMUP_API_KEY=your_sumup_key                        # OPTIONEEL — TODO: verifieer of nog actief gebruikt
