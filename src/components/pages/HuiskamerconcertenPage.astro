---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../ui/Button.astro';
import FilmStrip from '../sections/FilmStrip.astro';
import { Image } from 'astro:assets';
import { getLocaleFromUrl, useTranslations } from '../../i18n/utils';

import heroImg from '../../assets/photos/huiskamer/hk-esther-noordergraaf.jpg'; // Foto: Esther Noordergraaf Fotografie
import sfeerImg from '../../assets/photos/ed-struijlaart-lachend-gitaar.jpg';
import portretImg from '../../assets/photos/ed-struijlaart-raam.jpg';
import bruiloftImg from '../../assets/photos/huiskamer/hk-bruiloft.jpg';

// Sfeer foto's huiskamerconcerten
import hkSfeer01 from '../../assets/photos/huiskamer/hk-sfeer-01.jpg';
import hkSfeer02 from '../../assets/photos/huiskamer/hk-sfeer-02.jpg';
import hkSfeer03 from '../../assets/photos/huiskamer/hk-sfeer-03.jpg';
import hkSfeer04 from '../../assets/photos/huiskamer/hk-sfeer-04.jpg';
import hkGroep01 from '../../assets/photos/huiskamer/hk-groep-01.jpg';
import hkGroep02 from '../../assets/photos/huiskamer/hk-groep-02.jpg';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<BaseLayout
  title={t.houseConcerts.title}
  description={t.houseConcerts.description}
  adPixels
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Huiskamerconcert Ed Struijlaart",
      "description": "Boek Ed Struijlaart voor een intiem huiskamerconcert bij jou thuis. Geschikt voor 10 tot 50 personen. Privéconcert of met ticketverkoop.",
      "provider": {
        "@type": "Person",
        "name": "Ed Struijlaart",
        "url": "https://edstruijlaart.nl"
      },
      "serviceType": "Huiskamerconcert",
      "areaServed": {
        "@type": "Country",
        "name": "Nederland"
      },
      "url": "https://edstruijlaart.nl/huiskamerconcerten/",
      "offers": {
        "@type": "Offer",
        "priceCurrency": "EUR",
        "availability": "https://schema.org/InStock",
        "description": "Privéconcert voor een vaste prijs, of met ticketverkoop"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Hoe gaat een huiskamerconcert eraan toe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ed komt bij jou thuis met zijn gitaar. Hij speelt een intiem concert van ongeveer anderhalf uur met eigen songs, covers en verhalen. Volledig akoestisch, maar geluid kan meegenomen worden als het nodig is."
          }
        },
        {
          "@type": "Question",
          "name": "Hoeveel mensen passen er bij een huiskamerconcert?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Een huiskamerconcert is geschikt voor 10 tot 50 personen. Dat kan in je woonkamer, tuin, veranda of een andere ruimte. Jij regelt de locatie en het publiek."
          }
        },
        {
          "@type": "Question",
          "name": "Wat kost een huiskamerconcert?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Er zijn twee opties: een privéconcert voor een vaste prijs, of een concert met ticketverkoop waarmee je de kosten (deels) terugverdient. Neem contact op voor een offerte op maat."
          }
        },
        {
          "@type": "Question",
          "name": "Hoe boek ik een huiskamerconcert?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Boek direct via het boekingsformulier op boeken.edstruijlaart.nl of stuur een mail naar ed@earswantmusic.nl. Ed vertelt je graag meer over de mogelijkheden."
          }
        },
        {
          "@type": "Question",
          "name": "Voor welke gelegenheden is een huiskamerconcert geschikt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Huiskamerconcerten zijn ideaal voor verjaardagen, jubilea, afscheid, bedrijfsuitjes, of gewoon een bijzondere avond met vrienden. Bij mooi weer kan het ook in de tuin of onder de veranda."
          }
        }
      ]
    })} />
  </Fragment>
  <!-- Hero -->
  <section class="relative min-h-[60vh] flex items-end overflow-hidden">
    <Image
      src={heroImg}
      alt="Ed Struijlaart speelt een huiskamerconcert, foto Esther Noordergraaf Fotografie"
      widths={[640, 1024, 1920]}
      sizes="100vw"
      class="absolute inset-0 w-full h-full object-cover object-[center_55%]"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/40 to-black/40" />
    <div class="relative z-10 w-full px-4 sm:px-6 lg:px-8 pb-16 md:pb-20 max-w-[1200px] mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-sm font-medium bg-[var(--color-gold)]/20 text-[var(--color-gold)] mb-4">
        {t.houseConcerts.heroTag}
      </span>
      <h1 class="font-[var(--font-display)] text-4xl sm:text-5xl md:text-6xl text-white max-w-2xl">
        {t.houseConcerts.heroTitle}
      </h1>
      <p class="mt-4 text-lg text-white/80 max-w-xl">
        {t.houseConcerts.heroSubtitle}
      </p>
    </div>
    <span class="absolute bottom-3 right-4 z-10 text-[11px] text-white/40">
      Foto: Esther Noordergraaf Fotografie
    </span>
  </section>

  <!-- Introductie -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-[800px] px-4 sm:px-6 lg:px-8">
      <div class="prose-section">
        <p class="text-lg leading-relaxed" style="color: var(--fg-muted);">
          {t.houseConcerts.intro1}
        </p>

        <blockquote class="my-10 text-xl md:text-2xl font-[var(--font-display)] italic border-l-4 border-[var(--color-gold)] pl-6" style="color: var(--fg);">
          &ldquo;{t.houseConcerts.introQuote}&rdquo;
        </blockquote>

        <p class="text-lg leading-relaxed" style="color: var(--fg-muted);">
          {t.houseConcerts.intro2}
        </p>
      </div>
    </div>
  </section>

  <!-- YouTube video: hoe gaat een huiskamerconcert eraan toe? -->
  <section class="py-16 md:py-24" style="background-color: var(--bg-surface);">
    <div class="mx-auto max-w-[900px] px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <p class="text-sm font-medium uppercase tracking-wider" style="color: var(--color-gold);">{t.houseConcerts.videoLabel}</p>
        <h2 class="font-[var(--font-display)] text-2xl md:text-3xl mt-2">{t.houseConcerts.videoTitle}</h2>
      </div>
      <div class="relative rounded-2xl overflow-hidden" style="box-shadow: var(--shadow-card); aspect-ratio: 16/9;">
        <iframe
          src="https://www.youtube-nocookie.com/embed/luQq4YDNJ_c"
          title="Hoe gaat een huiskamerconcert eraan toe? - Ed Struijlaart"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
          class="absolute inset-0 w-full h-full border-0"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Sfeer impressie galerij -->
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-sm font-medium uppercase tracking-wider" style="color: var(--color-gold);">{t.houseConcerts.galleryLabel}</p>
        <h2 class="font-[var(--font-display)] text-2xl md:text-3xl mt-2">{t.houseConcerts.galleryTitle}</h2>
      </div>

      <!-- Masonry-style grid: 3 kolommen desktop, 2 mobile -->
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4" id="sfeer-grid">
        <!-- Rij 1: breed sfeerbeeld links (2 kolommen), staande foto rechts -->
        <button type="button" class="col-span-2 row-span-1 rounded-xl overflow-hidden cursor-pointer" data-lightbox="0" aria-label={t.common.enlargePhoto}>
          <Image
            src={hkSfeer02}
            alt="Huiskamerconcert vanuit het publiek, warme sfeerverlichting, iedereen luistert aandachtig"
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, 66vw"
            class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
            style="aspect-ratio: 3/2;"
            loading="lazy"
          />
        </button>
        <button type="button" class="col-span-1 row-span-2 rounded-xl overflow-hidden hidden md:block cursor-pointer" data-lightbox="1" aria-label={t.common.enlargePhoto}>
          <Image
            src={hkSfeer04}
            alt="Ed Struijlaart speelt gitaar in een huiskamer, staand portret met publiek op de voorgrond"
            widths={[400, 800, 1200]}
            sizes="33vw"
            class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
            loading="lazy"
          />
        </button>

        <!-- Rij 2: twee kleinere sfeerbeelden -->
        <button type="button" class="col-span-1 rounded-xl overflow-hidden cursor-pointer" data-lightbox="2" aria-label={t.common.enlargePhoto}>
          <Image
            src={hkSfeer01}
            alt="Ed Struijlaart speelt gitaar in een sfeervol verlichte huiskamer"
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 50vw, 33vw"
            class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
            style="aspect-ratio: 3/2;"
            loading="lazy"
          />
        </button>
        <button type="button" class="col-span-1 rounded-xl overflow-hidden cursor-pointer" data-lightbox="3" aria-label={t.common.enlargePhoto}>
          <Image
            src={hkSfeer03}
            alt="Intieme huiskamerconcert setting met publiek rondom de artiest"
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 50vw, 33vw"
            class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
            style="aspect-ratio: 3/2;"
            loading="lazy"
          />
        </button>

        <!-- Rij 3: twee groepsfoto's breed -->
        <button type="button" class="col-span-1 md:col-span-2 rounded-xl overflow-hidden cursor-pointer" data-lightbox="4" aria-label={t.common.enlargePhoto}>
          <Image
            src={hkGroep01}
            alt="Groepsfoto na een huiskamerconcert, publiek poseert samen met Ed"
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 50vw, 66vw"
            class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
            style="aspect-ratio: 16/9;"
            loading="lazy"
          />
        </button>
        <button type="button" class="col-span-1 rounded-xl overflow-hidden cursor-pointer" data-lightbox="5" aria-label={t.common.enlargePhoto}>
          <Image
            src={hkGroep02}
            alt="Groepsfoto na een huiskamerconcert, gezellige groep in de huiskamer"
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 50vw, 33vw"
            class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
            style="aspect-ratio: 16/9;"
            loading="lazy"
          />
        </button>
      </div>
    </div>
  </section>

  <!-- Foto + details -->
  <section class="py-20" style="background-color: var(--bg-surface);">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="rounded-2xl overflow-hidden" style="box-shadow: var(--shadow-card);">
          <Image
            src={sfeerImg}
            alt="Ed Struijlaart in een warme, intieme setting"
            width={600}
            class="w-full h-auto"
            loading="lazy"
          />
        </div>
        <div>
          <h2 class="font-[var(--font-display)] text-3xl md:text-4xl">{t.houseConcerts.expectTitle}</h2>
          <div class="mt-6 space-y-4">
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-[var(--color-gold)]/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-[var(--color-gold)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
              </div>
              <div>
                <h3 class="font-medium text-lg">{t.houseConcerts.expect1Title}</h3>
                <p class="text-sm" style="color: var(--fg-muted);">{t.houseConcerts.expect1Text}</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-[var(--color-gold)]/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-[var(--color-gold)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <div>
                <h3 class="font-medium text-lg">{t.houseConcerts.expect2Title}</h3>
                <p class="text-sm" style="color: var(--fg-muted);">{t.houseConcerts.expect2Text}</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-[var(--color-gold)]/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-[var(--color-gold)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              </div>
              <div>
                <h3 class="font-medium text-lg">{t.houseConcerts.expect3Title}</h3>
                <p class="text-sm" style="color: var(--fg-muted);">{t.houseConcerts.expect3Text}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Twee opties -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-[var(--font-display)] text-3xl md:text-4xl">{t.houseConcerts.bookingTitle}</h2>
        <p class="mt-4 text-lg max-w-2xl mx-auto" style="color: var(--fg-muted);">
          {t.houseConcerts.bookingSubtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Optie 1: Prive -->
        <div class="rounded-2xl p-8 relative overflow-hidden" style="background-color: var(--bg-surface); box-shadow: var(--shadow-card);">
          <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[var(--color-gold)]/10 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-[var(--color-gold)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3 class="font-[var(--font-display)] text-2xl">{t.houseConcerts.privateTitle}</h3>
          <p class="mt-3 text-base leading-relaxed" style="color: var(--fg-muted);">
            {t.houseConcerts.privateText}
          </p>
        </div>

        <!-- Optie 2: Tickets -->
        <div class="rounded-2xl p-8 relative overflow-hidden" style="background-color: var(--bg-surface); box-shadow: var(--shadow-card);">
          <span class="absolute top-4 right-4 px-3 py-1 rounded-full text-xs font-medium bg-[var(--color-gold)]/10 text-[var(--color-gold)]">
            {t.houseConcerts.popular}
          </span>
          <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[var(--color-gold)]/10 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-[var(--color-gold)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 3v4M8 3v4M2 11h20"/></svg>
          </div>
          <h3 class="font-[var(--font-display)] text-2xl">{t.houseConcerts.ticketTitle}</h3>
          <p class="mt-3 text-base leading-relaxed" style="color: var(--fg-muted);">
            {t.houseConcerts.ticketText}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Wat krijg je: concertpagina, gastenboek, bootleg -->
  <section class="py-20 md:py-28 relative overflow-hidden" style="background-color: var(--color-dark-bg);">
    <!-- Decoratieve glow -->
    <div class="absolute top-0 right-1/4 w-96 h-96 rounded-full blur-3xl opacity-[0.03]" style="background-color: var(--color-gold);"></div>
    <div class="absolute bottom-0 left-1/3 w-64 h-64 rounded-full blur-3xl opacity-[0.03]" style="background-color: var(--color-gold);"></div>

    <div class="relative mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <p class="text-sm font-medium uppercase tracking-wider text-[var(--color-gold)]">{t.houseConcerts.extrasLabel}</p>
        <h2 class="font-[var(--font-display)] text-3xl md:text-4xl text-white mt-2">
          {t.houseConcerts.extrasTitle}
        </h2>
        <p class="mt-4 text-lg max-w-2xl mx-auto text-white/60">
          {t.houseConcerts.extrasSubtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">

        <!-- Feature 1: Eigen concertpagina -->
        <div class="rounded-2xl p-8 border border-white/10" style="background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);">
          <div class="w-12 h-12 rounded-full flex items-center justify-center mb-5" style="background: rgba(184, 134, 11, 0.15);">
            <svg class="w-6 h-6 text-[var(--color-gold)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h3 class="font-[var(--font-display)] text-xl text-white">{t.houseConcerts.concertPageTitle}</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/60">
            {t.houseConcerts.concertPageText}
          </p>
        </div>

        <!-- Feature 2: Gastenboek -->
        <div class="rounded-2xl p-8 border border-white/10" style="background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);">
          <div class="w-12 h-12 rounded-full flex items-center justify-center mb-5" style="background: rgba(184, 134, 11, 0.15);">
            <svg class="w-6 h-6 text-[var(--color-gold)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
          </div>
          <h3 class="font-[var(--font-display)] text-xl text-white">{t.houseConcerts.guestbookTitle}</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/60">
            {t.houseConcerts.guestbookText}
          </p>
        </div>

        <!-- Feature 3: Bootleg -->
        <div class="rounded-2xl p-8 border border-[var(--color-gold)]/30 relative" style="background: linear-gradient(135deg, rgba(184, 134, 11, 0.08) 0%, rgba(184, 134, 11, 0.02) 100%);">
          <span class="absolute top-4 right-4 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-widest bg-red-500/20 text-red-400 border border-red-500/20">
            {t.houseConcerts.bootlegTag}
          </span>
          <div class="w-12 h-12 rounded-full flex items-center justify-center mb-5" style="background: rgba(184, 134, 11, 0.15);">
            <svg class="w-6 h-6 text-[var(--color-gold)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/>
            </svg>
          </div>
          <h3 class="font-[var(--font-display)] text-xl text-white">{t.houseConcerts.bootlegTitle}</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/60">
            {t.houseConcerts.bootlegText1}
          </p>
          <p class="mt-3 text-sm leading-relaxed text-white/60">
            {t.houseConcerts.bootlegText2}
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Wereldrecord filmstrip -->
  <FilmStrip />

  <!-- Stat + quote -->
  <section class="py-16 md:py-20 relative overflow-hidden" style="background-color: var(--color-dark-bg);">
    <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-64 h-64 rounded-full blur-3xl opacity-5" style="background-color: var(--color-gold);"></div>
    <div class="relative mx-auto max-w-[800px] px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-[var(--color-gold)] text-5xl md:text-6xl font-bold">{t.houseConcerts.statNumber}</p>
      <p class="mt-2 text-white/60 text-lg">{t.houseConcerts.statLabel}</p>
      <blockquote class="mt-8 text-xl md:text-2xl text-white/80 italic font-[var(--font-display)]">
        &ldquo;{t.houseConcerts.statQuote}&rdquo;
      </blockquote>
    </div>
  </section>

  <!-- Reviews -->
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-[var(--font-display)] text-3xl md:text-4xl">{t.houseConcerts.reviewsTitle}</h2>
        <p class="mt-3 text-lg" style="color: var(--fg-muted);">{t.houseConcerts.reviewsSubtitle}</p>
      </div>
      <div class="columns-1 md:columns-2 gap-6 space-y-6">
        {[
          { name: "Dennis", city: "Buren", text: "Wat een onvergetelijke avond! Ed wist met zijn eigen songs en prachtige klassiekers uit zijn Gitaarmannen-tours de hele kamer te betoveren. Tussen de liedjes door trakteerde hij ons op persoonlijke anekdotes en een gezonde dosis humor, waardoor het voelde alsof er een goede vriend op bezoek was die toevallig ook nog eens fantastisch gitaar speelt." },
          { name: "Sylvia", city: "Emmer-Compascuum", text: "Op Ed kun je bouwen, hij is op tijd, zingt mooie luisterliedjes met prachtige anekdotes en verhaaltjes tussendoor. Zijn stemgeluid is uniek, zijn gitaarspel is uitzonderlijk en zijn liedjes zijn prachtig. Het is altijd een feestje om Ed te verwelkomen." },
          { name: "Dick", city: "Lisse", text: "Ed kwam in ons tuinhuis spelen, een stormachtige avond, regen, tentzeilen enzo. Geweldig leuke verteller en topmuzikant! Hij vereerde onze eigen band die als voorprogramma had gespeeld met een gezamenlijke uitvoering van Crossroads!" },
          { name: "Fabienne", city: "Kessel (België)", text: "TOPavond met een TOPmuzikant, zanger en verteller. We hingen van de eerste tot de laatste seconde aan zijn lippen." },
          { name: "Laura", city: "Den Haag", text: "Veel mensen kennen Ed omdat de meeste uit zijn geboorteplaats komen, dus zijn liedjes waren voor ons een feest der herkenning. Ook de covers waren erg leuk! Wij hebben genoten en zouden het zo weer doen. Echt een aanrader." },
          { name: "Ellen van Reenen", city: "De Meern", text: "Geweldig optreden, mooie liedjes en Ed kan leuk verhalen vertellen. Publiek was enthousiast. 2 keer gedaan en de 3e keer gaat zeker volgen!" },
          { name: "Roel", city: "", text: "Vijftien jaar geleden een huiskamerconcert van Ed bijgewoond. Dat ik mij dat na al die jaren nog herinner is een groot compliment. Wat nog goed in mijn geheugen staat is de pure muziek, alleen de gitaar en de stem, maar ook de verhalen die Ed tussendoor vertelde." },
        ].map((review) => (
          <div class="break-inside-avoid rounded-xl p-6" style="background-color: var(--bg-surface); box-shadow: var(--shadow-card);">
            <div class="flex gap-0.5 mb-3">
              {Array.from({length: 5}).map(() => (
                <svg class="w-4 h-4 text-[var(--color-gold)]" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-[15px] leading-relaxed" style="color: var(--fg);">&ldquo;{review.text}&rdquo;</p>
            <p class="mt-4 text-sm font-medium">
              <span style="color: var(--color-gold);">{review.name}</span>
              {review.city && <span style="color: var(--fg-muted);"> - {review.city}</span>}
            </p>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <Button href="https://boeken.edstruijlaart.nl" variant="primary" size="lg" data-umami-event="landing-cta-boek">
          {t.houseConcerts.bookYours}
        </Button>
      </div>
    </div>
  </section>

  <!-- Bruiloften -->
  <section class="py-16 md:py-24" style="background-color: var(--bg-surface);">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="rounded-2xl overflow-hidden" style="box-shadow: var(--shadow-card);">
          <Image
            src={bruiloftImg}
            alt="Ed Struijlaart speelt op een bruiloft"
            widths={[400, 800]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
        </div>
        <div>
          <p class="text-sm font-medium uppercase tracking-wider text-[var(--color-gold)] mb-2">{t.houseConcerts.weddingLabel}</p>
          <h2 class="font-[var(--font-display)] text-3xl md:text-4xl">{t.houseConcerts.weddingTitle}</h2>
          <p class="mt-4 text-lg leading-relaxed" style="color: var(--fg-muted);">
            {t.houseConcerts.weddingText1}
          </p>
          <p class="mt-4 text-lg leading-relaxed" style="color: var(--fg-muted);">
            {t.houseConcerts.weddingText2}
          </p>
          <div class="mt-8">
            <Button href="mailto:ed@earswantmusic.nl?subject=Muziek%20op%20onze%20bruiloft" variant="primary" size="lg">
              {t.houseConcerts.weddingCta}
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Boeken CTA -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="font-[var(--font-display)] text-3xl md:text-4xl">{t.houseConcerts.ctaTitle}</h2>
          <p class="mt-4 text-lg" style="color: var(--fg-muted);">
            {t.houseConcerts.ctaText}
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <Button href="https://boeken.edstruijlaart.nl" variant="primary" size="lg" data-umami-event="landing-cta-boek-direct">
              {t.houseConcerts.ctaDirect}
            </Button>
            <Button href="mailto:ed@earswantmusic.nl" variant="outline" size="lg">
              {t.houseConcerts.ctaMail}
            </Button>
          </div>
          <p class="mt-6 text-sm" style="color: var(--fg-muted);">
            {t.houseConcerts.ctaOrContact} <a href="mailto:ed@earswantmusic.nl" class="text-[var(--color-gold)] hover:underline">ed@earswantmusic.nl</a>
          </p>
        </div>
        <div class="rounded-2xl overflow-hidden" style="box-shadow: var(--shadow-card);">
          <Image
            src={portretImg}
            alt="Ed Struijlaart met gitaar bij het raam"
            width={560}
            class="w-full h-auto"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Lightbox overlay -->
  <div
    id="lightbox"
    class="fixed inset-0 hidden items-center justify-center"
    style="z-index: 9999; background: rgba(0,0,0,0.92);"
    role="dialog"
    aria-modal="true"
    aria-label={t.common.enlargePhoto}
  >
    <!-- Sluiten -->
    <button
      id="lb-close"
      type="button"
      class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center rounded-full text-white/70 hover:text-white hover:bg-white/10 transition-colors z-10"
      aria-label={t.common.close}
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>

    <!-- Vorige -->
    <button
      id="lb-prev"
      type="button"
      class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 w-10 h-10 flex items-center justify-center rounded-full text-white/70 hover:text-white hover:bg-white/10 transition-colors z-10"
      aria-label={t.common.previous}
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    </button>

    <!-- Volgende -->
    <button
      id="lb-next"
      type="button"
      class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 w-10 h-10 flex items-center justify-center rounded-full text-white/70 hover:text-white hover:bg-white/10 transition-colors z-10"
      aria-label={t.common.next}
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
    </button>

    <!-- Foto -->
    <img
      id="lb-img"
      src=""
      alt=""
      class="max-h-[85vh] max-w-[90vw] object-contain rounded-lg select-none"
      style="transition: opacity 0.2s ease;"
    />

    <!-- Teller -->
    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 text-white/50 text-sm" id="lb-counter"></div>
  </div>

  <script>
    function initLightbox() {
      const lightbox = document.getElementById('lightbox');
      const lbImg = document.getElementById('lb-img') as HTMLImageElement;
      const lbClose = document.getElementById('lb-close');
      const lbPrev = document.getElementById('lb-prev');
      const lbNext = document.getElementById('lb-next');
      const lbCounter = document.getElementById('lb-counter');
      if (!lightbox || !lbImg) return;

      // Verzamel alle foto's uit de grid
      const grid = document.getElementById('sfeer-grid');
      if (!grid) return;
      const buttons = Array.from(grid.querySelectorAll('[data-lightbox]'));
      const photos: { src: string; alt: string }[] = [];

      buttons.forEach(btn => {
        const img = btn.querySelector('img');
        if (img) {
          // Pak de grootste srcset URL, of fallback naar src
          let src = img.src;
          if (img.srcset) {
            const parts = img.srcset.split(',').map(s => s.trim());
            const last = parts[parts.length - 1];
            src = last.split(' ')[0];
          }
          photos.push({ src, alt: img.alt || '' });
        }
      });

      let current = 0;

      function show(index: number) {
        current = (index + photos.length) % photos.length;
        lbImg.style.opacity = '0';
        setTimeout(() => {
          lbImg.src = photos[current].src;
          lbImg.alt = photos[current].alt;
          lbImg.style.opacity = '1';
        }, 100);
        if (lbCounter) lbCounter.textContent = `${current + 1} / ${photos.length}`;
      }

      function open(index: number) {
        show(index);
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function close() {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        document.body.style.overflow = '';
      }

      // Klik op grid foto
      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-lightbox') || '0');
          open(idx);
        });
      });

      // Controls
      lbClose?.addEventListener('click', close);
      lbPrev?.addEventListener('click', () => show(current - 1));
      lbNext?.addEventListener('click', () => show(current + 1));

      // Klik op achtergrond sluit
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) close();
      });

      // Keyboard
      document.addEventListener('keydown', (e) => {
        if (lightbox.classList.contains('hidden')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') show(current - 1);
        if (e.key === 'ArrowRight') show(current + 1);
      });

      // Swipe support (mobile)
      let touchStartX = 0;
      lightbox.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
      }, { passive: true });
      lightbox.addEventListener('touchend', (e) => {
        const diff = touchStartX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) show(current + 1);
          else show(current - 1);
        }
      }, { passive: true });
    }

    initLightbox();
    document.addEventListener('astro:after-swap', initLightbox);
  </script>
</BaseLayout>
