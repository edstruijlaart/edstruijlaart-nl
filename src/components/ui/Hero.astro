---
import { Image } from 'astro:assets';

interface CTA {
  label: string;
  href: string;
}

interface Slide {
  image: ImageMetadata;
  imagePosition?: string;
  // Optionele bewegende achtergrond (stil, loopt). `image` blijft de poster/fallback
  // (o.a. bij prefers-reduced-motion en tot de video speelt).
  video?: { src: string; srcMobile?: string };
  // Hoe lang deze slide blijft staan (ms). Default 7000; video-slides typisch de videolengte.
  durationMs?: number;
  tagline?: string;
  title?: string;
  subtitle?: string;
  ctaPrimary?: CTA;
  ctaSecondary?: CTA;
}

interface Props {
  // Legacy single-content props (toegepast op alle slides als slides geen eigen content hebben)
  title?: string;
  subtitle?: string;
  tagline?: string;
  images?: ImageMetadata[];
  image?: ImageMetadata;
  imageAlt?: string;
  imagePositions?: string[];
  height?: 'full' | 'large' | 'medium';
  ctaPrimary?: CTA;
  ctaSecondary?: CTA;
  // Nieuw: slides met per-slide content
  slides?: Slide[];
}

const {
  title,
  subtitle,
  tagline,
  images,
  image,
  imageAlt = 'Ed Struijlaart',
  imagePositions,
  height = 'large',
  ctaPrimary,
  ctaSecondary,
  slides,
} = Astro.props;

const heightClasses: Record<string, string> = {
  full: 'min-h-screen',
  large: 'min-h-[85vh]',
  medium: 'min-h-[50vh]',
};

// Bouw effective slides:
// - Als `slides` prop is meegegeven, gebruik die direct
// - Anders: maak slides uit images/image + globale title/subtitle/tagline/cta's
let effectiveSlides: Slide[] = [];
if (slides && slides.length > 0) {
  effectiveSlides = slides;
} else {
  const imgs = images && images.length > 0 ? images : image ? [image] : [];
  effectiveSlides = imgs.map((img, i) => ({
    image: img,
    imagePosition: imagePositions?.[i],
    tagline,
    title,
    subtitle,
    ctaPrimary,
    ctaSecondary,
  }));
}

const hasMultipleSlides = effectiveSlides.length > 1;
const hasVideo = effectiveSlides.some((s) => s.video);
---

<section class:list={['hero-section relative flex items-end overflow-hidden', heightClasses[height]]}>
  {/* Background images */}
  {effectiveSlides.map((slide, i) => (
    <div
      class:list={[
        'hero-slide absolute inset-0 w-full h-full transition-opacity duration-1000',
        i === 0 ? 'opacity-100' : 'opacity-0',
      ]}
      data-slide-index={i}
      data-duration={slide.durationMs ?? 7000}
    >
      <Image
        src={slide.image}
        alt={`${imageAlt}${effectiveSlides.length > 1 ? ` ${i + 1}` : ''}`}
        widths={[640, 1024, 1920]}
        sizes="100vw"
        class="w-full h-full object-cover"
        style={slide.imagePosition ? `object-position: ${slide.imagePosition}` : undefined}
        loading={i === 0 ? "eager" : "lazy"}
        fetchpriority={i === 0 ? "high" : undefined}
      />
      {slide.video && (
        <video
          class="hero-video absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-700"
          style={slide.imagePosition ? `object-position: ${slide.imagePosition}` : undefined}
          muted
          loop
          playsinline
          autoplay={i === 0}
          preload={i === 0 ? 'auto' : 'none'}
          aria-hidden="true"
          data-video-index={i}
        >
          {slide.video.srcMobile && <source src={slide.video.srcMobile} type="video/mp4" media="(max-width: 1024px)" />}
          <source src={slide.video.src} type="video/mp4" />
        </video>
      )}
    </div>
  ))}

  {/* Gradient overlay - stronger at bottom for text readability */}
  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent" />

  {/* Per-slide content - aligned to bottom */}
  {effectiveSlides.map((slide, i) => (
    <div
      class:list={[
        'hero-content absolute inset-0 z-10 flex items-end transition-opacity duration-1000',
        i === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none',
      ]}
      data-content-index={i}
    >
      <div class="w-full px-4 sm:px-6 lg:px-8 pb-16 md:pb-20 lg:pb-24 max-w-[1200px] mx-auto">
        {slide.tagline && (
          <p class="text-[var(--color-gold)] text-sm font-medium uppercase tracking-widest mb-4 [text-shadow:0_1px_10px_rgb(0_0_0/0.7)]">
            {slide.tagline}
          </p>
        )}
        {slide.title && (
          <h1 class="font-[var(--font-display)] text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-white leading-tight max-w-3xl">
            {slide.title}
          </h1>
        )}
        {slide.subtitle && (
          <p class="mt-4 text-base sm:text-lg md:text-xl text-white/80 tracking-wide max-w-2xl [text-shadow:0_1px_10px_rgb(0_0_0/0.6)]">
            {slide.subtitle}
          </p>
        )}
        {(slide.ctaPrimary || slide.ctaSecondary) && (
          <div class="mt-8 flex flex-wrap gap-4">
            {slide.ctaPrimary && (
              <a
                href={slide.ctaPrimary.href}
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-medium text-base bg-[var(--color-gold)] text-white hover:bg-[var(--color-gold-light)] transition-colors duration-300"
              >
                {slide.ctaPrimary.label}
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            )}
            {slide.ctaSecondary && (
              <a
                href={slide.ctaSecondary.href}
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-medium text-base border-2 border-white/40 text-white hover:border-white hover:bg-white/10 transition-all duration-300"
              >
                {slide.ctaSecondary.label}
              </a>
            )}
          </div>
        )}
        {i === 0 && <slot />}
      </div>
    </div>
  ))}

  {/* Slide indicators */}
  {hasMultipleSlides && (
    <div class="absolute bottom-6 right-8 z-20 flex gap-2" aria-label="Slide navigatie">
      {effectiveSlides.map((_, i) => (
        <button
          class:list={[
            'hero-dot w-2 h-2 rounded-full transition-all duration-300',
            i === 0 ? 'bg-white w-6' : 'bg-white/50',
          ]}
          data-dot-index={i}
          aria-label={`Slide ${i + 1}`}
        />
      ))}
    </div>
  )}
</section>

{(hasMultipleSlides || hasVideo) && (
  <script>
    const w = window as unknown as { __heroTimer?: ReturnType<typeof setTimeout> };

    function initHeroSlider() {
      const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
      const contents = document.querySelectorAll<HTMLElement>('.hero-content');
      const dots = document.querySelectorAll<HTMLElement>('.hero-dot');
      if (slides.length === 0) return;
      clearTimeout(w.__heroTimer);

      // Video's: stil, alleen de actieve slide speelt; bij reduced motion blijft de posterfoto staan
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const videoAt = (i: number) => slides[i]?.querySelector<HTMLVideoElement>('video.hero-video') ?? null;
      slides.forEach((_, i) => {
        const v = videoAt(i);
        v?.addEventListener('playing', () => {
          v.classList.remove('opacity-0');
          v.classList.add('opacity-100');
        });
      });
      function playVideo(i: number) {
        const v = videoAt(i);
        if (!v || reduceMotion) return;
        if (v.preload === 'none') v.preload = 'auto';
        try { v.currentTime = 0; } catch {}
        v.play()?.catch(() => {});
      }
      function pauseVideo(i: number) {
        videoAt(i)?.pause();
      }
      if (reduceMotion) slides.forEach((_, i) => pauseVideo(i));

      let current = 0;
      const total = slides.length;
      playVideo(0);
      if (total <= 1) return;

      const durationOf = (i: number) => Number(slides[i].dataset.duration) || 7000;
      function schedule() {
        clearTimeout(w.__heroTimer);
        w.__heroTimer = setTimeout(() => goTo((current + 1) % total), durationOf(current));
      }

      function goTo(index: number) {
        pauseVideo(current);
        slides[current].classList.remove('opacity-100');
        slides[current].classList.add('opacity-0');
        contents[current]?.classList.remove('opacity-100');
        contents[current]?.classList.add('opacity-0', 'pointer-events-none');
        dots[current].classList.remove('bg-white', 'w-6');
        dots[current].classList.add('bg-white/50');

        current = index;

        slides[current].classList.remove('opacity-0');
        slides[current].classList.add('opacity-100');
        contents[current]?.classList.remove('opacity-0', 'pointer-events-none');
        contents[current]?.classList.add('opacity-100');
        dots[current].classList.remove('bg-white/50');
        dots[current].classList.add('bg-white', 'w-6');
        playVideo(current);
        schedule();
      }

      // Auto-advance per slide (default 7 s, video-slides zo lang als de video)
      schedule();

      // Click dots to navigate
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => goTo(i));
      });
    }

    initHeroSlider();
    document.addEventListener('astro:after-swap', initHeroSlider);
  </script>
)}
