---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import makeItOnYourOwn from '../../assets/albums/make-it-on-your-own.png';
import closerThanSkin from '../../assets/albums/closer-than-skin.jpg';
import headHeartHands from '../../assets/albums/head-heart-hands.jpg';
---

<div class="max-w-4xl mx-auto">
  <!-- Featured: Make It On Your Own -->
  <a href="/music/" class="group block">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 items-center">
      <div class="rounded-lg overflow-hidden max-w-xs mx-auto sm:mx-0" style="box-shadow: var(--shadow-card);">
        <Image
          src={makeItOnYourOwn}
          alt="Make It On Your Own single artwork"
          widths={[300, 400]}
          sizes="(max-width: 640px) 100vw, 300px"
          class="w-full aspect-square object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
      </div>
      <div class="text-center sm:text-left">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-medium uppercase tracking-wide" style="background-color: rgba(184, 134, 11, 0.1); color: var(--color-gold);">
          Platina Single
        </span>
        <h3 class="mt-2 font-[var(--font-display)] text-2xl">Make It On Your Own</h3>
        <p class="mt-1 text-xl font-[var(--font-display)]" style="color: var(--color-gold);">26M+ Streams</p>
        <p class="mt-2 text-sm" style="color: var(--fg-muted);">2 albums &middot; 29 singles</p>
      </div>
    </div>
  </a>

  <!-- Album thumbs -->
  <div class="mt-6 flex justify-center gap-4">
    {[
      { img: closerThanSkin, alt: 'Closer Than Skin' },
      { img: headHeartHands, alt: 'Head, Heart & Hands' },
    ].map(({ img, alt }) => (
      <a href="/music/" class="group block">
        <div class="w-20 h-20 rounded-lg overflow-hidden" style="box-shadow: var(--shadow-card);">
          <Image
            src={img}
            alt={alt}
            widths={[80, 160]}
            sizes="80px"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
          />
        </div>
      </a>
    ))}
  </div>

  <!-- CTA -->
  <div class="mt-6 text-center">
    <Button href="/music/" variant="primary">
      Ontdek alle muziek →
    </Button>
  </div>
</div>
