---
import { shows as staticShows } from '../../data/shows';
import Button from '../ui/Button.astro';
import { getLocaleFromUrl, useTranslations } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

interface Props {
  limit?: number;
}

const { limit } = Astro.props;

// Single source of truth: src/data/shows.ts
// Geen externe afhankelijkheden (Bandsintown is alleen voor syndicatie naar Spotify/On Tour)
const today = new Date();
today.setHours(0, 0, 0, 0);

const shows = [...staticShows]
  .filter(show => new Date(show.date) >= today)
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

const displayShows = limit ? shows.slice(0, limit) : shows;

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  const day = date.getDate();
  const month = date.toLocaleDateString('nl-NL', { month: 'short' }).toUpperCase();
  return { day, month };
}

const LISTMONK_FORM_URL = 'https://newsletter.earswantmusic.nl/subscription/form';
---

{displayShows.length > 0 ? (
  <div class="space-y-4">
    {displayShows.map(show => {
      const { day, month } = formatDate(show.date);
      const showUrl = show.isHuiskamerconcert && show.showPageUrl ? show.showPageUrl : undefined;
      const hasInterestForm = !!show.listmonkUuid && !show.ticketUrl && !show.soldOut && !show.isHuiskamerconcert;
      return (
        <div
          class="show-item flex items-center gap-4 sm:gap-6 p-4 rounded-xl border-l-4 border-transparent hover:border-[var(--color-gold)] transition-all duration-300 hover:-translate-y-0.5"
          style="background-color: var(--bg-surface); box-shadow: var(--shadow-card);"
        >
          {/* Datum badge */}
          <div class="flex-shrink-0 w-16 h-16 rounded-lg flex flex-col items-center justify-center bg-[var(--color-gold)] text-white">
            <span class="text-2xl font-bold leading-none">{day}</span>
            <span class="text-xs uppercase tracking-wider">{month}</span>
          </div>

          {/* Info */}
          <div class="flex-1 min-w-0">
            <h3 class="font-medium text-base truncate">
              {showUrl ? (
                <a href={showUrl} class="hover:text-[var(--color-gold)] transition-colors">{show.venue}</a>
              ) : show.venue}
            </h3>
            <p class="text-sm text-[var(--fg-muted)]">{show.city}</p>
            {show.production && !show.isHuiskamerconcert && (
              <p class="text-sm text-[var(--color-gold)]">{show.production}</p>
            )}
            {show.isHuiskamerconcert && (
              <p class="text-xs font-medium uppercase tracking-wider mt-0.5" style="color: var(--color-gold);">
                {t.showList.houseConcert}
              </p>
            )}
          </div>

          {/* Action */}
          <div class="flex-shrink-0">
            {show.soldOut ? (
              <span class="px-4 py-2 rounded-full text-sm font-medium bg-[var(--fg-muted)]/20 text-[var(--fg-muted)]">
                {t.showList.soldOut}
              </span>
            ) : show.ticketUrl ? (
              <Button href={show.ticketUrl} variant="outline" size="sm">
                Tickets
              </Button>
            ) : showUrl ? (
              <Button href={showUrl} variant="outline" size="sm">
                Info
              </Button>
            ) : hasInterestForm ? (
              <button
                type="button"
                class="show-interest-btn inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium border border-[var(--color-gold)]/60 text-[var(--color-gold)] hover:bg-[var(--color-gold)] hover:text-white transition-all duration-200 cursor-pointer"
                data-show-uuid={show.listmonkUuid}
                data-show-venue={show.venue}
                data-show-city={show.city}
                data-show-date={show.date}
                data-show-time={show.time || ''}
              >
                Hou me op de hoogte
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </button>
            ) : null}
          </div>
        </div>
      );
    })}
  </div>
) : (
  <div class="rounded-xl p-8 text-center border border-[var(--color-gold)]/30" style="background-color: var(--bg-surface); box-shadow: var(--shadow-card);">
    <p class="text-xs uppercase tracking-widest text-[var(--color-gold)] font-medium mb-3">{t.showList.comingSoon}</p>
    <h3 class="text-xl font-semibold mb-2">{t.showList.gm4Title}</h3>
    <p class="text-[var(--fg-muted)] mb-5">
      {t.showList.gm4Text}
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href="/huiskamerconcerten/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-medium border border-[var(--color-gold)]/60 text-[var(--color-gold)] hover:bg-[var(--color-gold)] hover:text-black transition-all duration-200"
      >
        {t.showList.bookHouseConcert}
      </a>
    </div>
  </div>
)}

{limit && shows.length > limit && (
  <div class="mt-8 text-center">
    <Button href="/tour/" variant="ghost">
      {t.showList.viewAll}
    </Button>
  </div>
)}

{/* Per-show interest modal (één modal, dynamisch gevuld) */}
<div id="show-interest-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" style="background-color: rgba(0,0,0,0.7);">
  <div class="relative w-full max-w-md rounded-2xl p-8" style="background-color: var(--bg-surface); box-shadow: var(--shadow-card);">
    <button type="button" id="close-show-modal" class="absolute top-4 right-4 text-[var(--fg-muted)] hover:text-[var(--fg)] transition-colors text-xl leading-none cursor-pointer" aria-label="Sluiten">&times;</button>
    <div id="show-modal-content" class="text-center">
      <p class="text-xs uppercase tracking-widest text-[var(--color-gold)] font-medium mb-2" id="show-modal-eyebrow">Krijg een herinnering</p>
      <h3 class="font-[var(--font-display)] text-2xl mb-1" id="show-modal-title"></h3>
      <p class="text-sm text-[var(--fg-muted)] mb-1" id="show-modal-subtitle"></p>
      <p class="text-base text-[var(--fg-muted)] mt-4 mb-6">
        Laat je e-mailadres achter en je hoort het persoonlijk zodra de kaartverkoop voor deze show start, plus updates van Ed.
      </p>
      <form id="show-interest-form" class="flex flex-col gap-3" action={LISTMONK_FORM_URL} method="POST">
        <input type="hidden" name="nonce" value="" />
        <input type="hidden" name="l" id="show-modal-list" value="" />
        <input
          type="text"
          name="name"
          placeholder="Je naam"
          autocomplete="name"
          class="px-4 py-3 rounded-full text-base border transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-[var(--color-gold)] focus:border-transparent bg-[var(--bg)] border-[var(--bg-surface)] text-[var(--fg)] placeholder:text-[var(--fg-muted)]"
        />
        <input
          type="email"
          name="email"
          required
          placeholder="Je e-mailadres"
          autocomplete="email"
          class="px-4 py-3 rounded-full text-base border transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-[var(--color-gold)] focus:border-transparent bg-[var(--bg)] border-[var(--bg-surface)] text-[var(--fg)] placeholder:text-[var(--fg-muted)]"
        />
        <button type="submit" class="px-6 py-3 rounded-full font-medium text-base text-white transition-colors duration-300 bg-[var(--color-gold)] hover:bg-[var(--color-gold-light)] focus:outline-none focus:ring-2 focus:ring-[var(--color-gold)] focus:ring-offset-2">
          Hou me op de hoogte
        </button>
        <p class="text-xs text-[var(--fg-muted)] mt-1">Geen spam. Alleen updates rond deze show.</p>
      </form>
      <div id="show-modal-success" class="hidden mt-2">
        <div class="mx-auto w-12 h-12 rounded-full flex items-center justify-center mb-3" style="background-color: var(--color-gold);">
          <svg width="24" height="24" fill="none" stroke="white" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </div>
        <p class="font-medium">Je staat op de lijst</p>
        <p class="text-sm text-[var(--fg-muted)] mt-1">Je hoort het zodra de kaartverkoop voor deze show start.</p>
      </div>
    </div>
  </div>
</div>

{/* Event structured data voor SEO */}
{shows.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify(
    shows.map(show => ({
      "@context": "https://schema.org",
      "@type": "MusicEvent",
      "name": show.production
        ? `${show.production} - Ed Struijlaart`
        : `Ed Struijlaart in ${show.city}`,
      "startDate": show.date,
      "location": {
        "@type": "Place",
        "name": show.venue,
        "address": {
          "@type": "PostalAddress",
          "addressLocality": show.city,
          "addressCountry": "NL",
        },
      },
      "performer": {
        "@type": "Person",
        "name": "Ed Struijlaart",
      },
      ...(show.ticketUrl ? {
        "offers": {
          "@type": "Offer",
          "url": show.ticketUrl,
          "availability": show.soldOut
            ? "https://schema.org/SoldOut"
            : "https://schema.org/InStock",
        },
      } : {}),
      "eventStatus": "https://schema.org/EventScheduled",
    }))
  )} />
)}

<style>
  .show-item:hover {
    box-shadow: var(--shadow-card-hover) !important;
  }
</style>

<script>
  function initShowInterestModal() {
    const modal = document.getElementById('show-interest-modal');
    const closeBtn = document.getElementById('close-show-modal');
    const titleEl = document.getElementById('show-modal-title');
    const subtitleEl = document.getElementById('show-modal-subtitle');
    const listInput = document.getElementById('show-modal-list') as HTMLInputElement | null;
    const form = document.getElementById('show-interest-form') as HTMLFormElement | null;
    const successEl = document.getElementById('show-modal-success');
    if (!modal || !closeBtn || !titleEl || !subtitleEl || !listInput || !form || !successEl) return;

    const buttons = document.querySelectorAll<HTMLButtonElement>('.show-interest-btn');

    function open(btn: HTMLButtonElement) {
      const uuid = btn.dataset.showUuid || '';
      const venue = btn.dataset.showVenue || '';
      const city = btn.dataset.showCity || '';
      const date = btn.dataset.showDate || '';
      const time = btn.dataset.showTime || '';

      const d = new Date(date);
      const formatted = d.toLocaleDateString('nl-NL', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

      titleEl!.textContent = `${venue}, ${city}`;
      subtitleEl!.textContent = time ? `${formatted} — ${time}` : formatted;
      listInput!.value = uuid;

      // reset states
      form!.classList.remove('hidden');
      successEl!.classList.add('hidden');

      modal!.classList.remove('hidden');
      modal!.classList.add('flex');
      modal!.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
    }

    function close() {
      modal!.classList.add('hidden');
      modal!.classList.remove('flex');
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => open(btn));
    });

    closeBtn.addEventListener('click', close);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal!.classList.contains('hidden')) close();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = form!.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;

      try {
        const fd = new FormData(form!);
        await fetch(form!.action, { method: 'POST', body: fd, mode: 'no-cors' });
        // Show success
        form!.classList.add('hidden');
        successEl!.classList.remove('hidden');
        form!.reset();
      } catch {
        // Fallback: native submit
        form!.submit();
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }

  initShowInterestModal();
  document.addEventListener('astro:after-swap', initShowInterestModal);
</script>
