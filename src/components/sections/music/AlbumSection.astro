---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Album } from '../../../data/music';
import SpotifyEmbed from '../../ui/SpotifyEmbed.astro';

interface Props {
  album: Album;
  artwork: ImageMetadata;
  reverse?: boolean;
}

const { album, artwork, reverse = false } = Astro.props;
---

<div id={album.slug} class:list={['grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-start', reverse && 'lg:[direction:rtl]']}>
  <!-- Artwork -->
  <div class:list={['max-w-md mx-auto lg:mx-0', reverse && 'lg:[direction:ltr]']}>
    <div class="rounded-xl overflow-hidden" style="box-shadow: var(--shadow-card);">
      <Image
        src={artwork}
        alt={`${album.title} album artwork`}
        widths={[400, 600]}
        sizes="(max-width: 1024px) 100vw, 500px"
        class="w-full h-auto"
        loading="lazy"
      />
    </div>
  </div>

  <!-- Content -->
  <div class:list={[reverse && 'lg:[direction:ltr]']}>
    <span class="inline-block px-3 py-1 rounded-full text-xs font-medium uppercase tracking-wide" style="background-color: rgba(184, 134, 11, 0.1); color: var(--color-gold);">
      {album.year}
    </span>
    <h2 class="mt-3 font-[var(--font-display)] text-3xl md:text-4xl lg:text-5xl">
      {album.title}
    </h2>
    <p class="mt-2 text-sm" style="color: var(--fg-muted);">
      Producer: {album.producer}{album.label ? ` · ${album.label}` : ''}
    </p>
    <div class="mt-3 h-1 w-16 rounded-full" style="background: linear-gradient(90deg, var(--color-gold-dark), var(--color-gold), var(--color-gold-light));"></div>
    <p class="mt-6 text-base md:text-lg leading-relaxed" style="color: var(--fg-muted);">
      {album.description}
    </p>

    <!-- Tracklist -->
    <div class="mt-8">
      <h3 class="text-sm font-medium uppercase tracking-wide mb-4" style="color: var(--color-gold);">
        Tracklist
      </h3>
      <ol class="tracklist columns-1 sm:columns-2 gap-x-8">
        {album.tracks.map((track, i) => (
          <li class="flex items-baseline gap-3 py-1.5 break-inside-avoid">
            <span class="text-sm font-medium tabular-nums min-w-[1.5rem] text-right" style="color: var(--color-gold);">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="text-sm" style="color: var(--fg-muted);">
              {track}
            </span>
          </li>
        ))}
      </ol>
    </div>

    <!-- Spotify embed -->
    <div class="mt-8">
      <SpotifyEmbed uri={album.spotifyId} type="album" compact />
    </div>
  </div>
</div>
