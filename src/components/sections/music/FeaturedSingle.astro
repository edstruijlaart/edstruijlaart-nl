---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Single } from '../../../data/music';
import { spotifyTrackUrl } from '../../../lib/spotify';

interface Props {
  single: Single;
  artwork?: ImageMetadata;
  artworkUrl?: string;
  reverse?: boolean;
}

const { single, artwork, artworkUrl, reverse = false } = Astro.props;
const spotifyUrl = spotifyTrackUrl(single.spotifyId);
---

<div class:list={['grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center', reverse && 'lg:[direction:rtl]']}>
  <!-- Artwork -->
  <div class:list={['max-w-md mx-auto lg:mx-0', reverse && 'lg:[direction:ltr]']}>
    <a href={spotifyUrl} target="_blank" rel="noopener noreferrer" class="group block">
      <div class="rounded-xl overflow-hidden relative" style="box-shadow: var(--shadow-card);">
        {artwork ? (
          <Image
            src={artwork}
            alt={`${single.title} artwork`}
            widths={[300, 500]}
            sizes="(max-width: 1024px) 100vw, 400px"
            class="w-full aspect-square object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        ) : artworkUrl ? (
          <img
            src={artworkUrl}
            alt={`${single.title} artwork`}
            width="300"
            height="300"
            class="w-full aspect-square object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        ) : (
          <div class="w-full aspect-square flex items-center justify-center" style="background-color: var(--bg-surface);">
            <span class="text-[var(--color-gold)] text-xl font-[var(--font-display)]">{single.title}</span>
          </div>
        )}
        <!-- Hover overlay -->
        <div class="absolute inset-0 bg-[var(--color-gold)]/0 group-hover:bg-[var(--color-gold)]/10 transition-colors duration-300 flex items-center justify-center">
          <svg class="w-16 h-16 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300 drop-shadow-lg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/>
          </svg>
        </div>
      </div>
    </a>
  </div>

  <!-- Content -->
  <div class:list={[reverse && 'lg:[direction:ltr]']}>
    <span class="inline-block px-3 py-1 rounded-full text-xs font-medium uppercase tracking-wide" style="background-color: rgba(184, 134, 11, 0.1); color: var(--color-gold);">
      {single.year}{single.featuring ? ` · ft. ${single.featuring}` : ''}
    </span>
    <h3 class="mt-3 font-[var(--font-display)] text-2xl md:text-3xl lg:text-4xl">
      {single.title}
    </h3>
    {single.featuring && (
      <p class="mt-1 text-base" style="color: var(--fg-muted);">
        ft. {single.featuring}
      </p>
    )}
    <div class="mt-3 h-1 w-12 rounded-full" style="background: linear-gradient(90deg, var(--color-gold-dark), var(--color-gold));"></div>
    {single.story && (
      <p class="mt-4 text-base md:text-lg leading-relaxed" style="color: var(--fg-muted);">
        {single.story}
      </p>
    )}
    <a
      href={spotifyUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 mt-6 px-5 py-2.5 rounded-full text-sm font-medium text-white transition-colors duration-300"
      style="background-color: var(--color-spotify);"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
      </svg>
      Luister op Spotify
    </a>
  </div>
</div>
