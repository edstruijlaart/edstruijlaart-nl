---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import { getLocaleFromUrl, useTranslations } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// Slide images
import concertfilmThumb from '../../assets/theater/gitaarmannen-3-concertfilm-thumbnail.jpg';
import posterImage from '../../assets/theater/gitaarmannen-3-poster.png';
import huiskamerImage from '../../assets/photos/ed-struijlaart-warm-interieur.jpg';

interface Slide {
  badge: string;
  title: string;
  subtitle?: string;
  description: string;
  ctaPrimary: { label: string; href: string; external?: boolean };
  ctaSecondary?: { label: string; href: string; external?: boolean };
  image: ImageMetadata;
  imageAlt: string;
  youtubeId?: string;
}

const slides: Slide[] = [
  {
    badge: t.carousel.newBadge,
    title: t.carousel.concertFilmTitle,
    subtitle: t.carousel.concertFilmSubtitle,
    description: t.carousel.concertFilmDesc,
    ctaPrimary: { label: t.carousel.concertFilmCta, href: 'https://payhip.com/b/QZ7Fi', external: true },
    image: concertfilmThumb,
    imageAlt: 'Gitaarmannen 3: John Mayer concertfilm',
    youtubeId: 'Jl7qoEpe9xk',
  },
  {
    badge: t.carousel.theaterBadge,
    title: t.carousel.theaterTitle,
    subtitle: t.carousel.theaterSubtitle,
    description: t.carousel.theaterDesc,
    ctaPrimary: { label: t.carousel.theaterCtaDates, href: '/tour/' },
    ctaSecondary: { label: t.carousel.theaterCtaMore, href: '/tour/' },
    image: posterImage,
    imageAlt: 'Gitaarmannen 3: John Mayer theaterposter',
  },
  {
    badge: t.carousel.bookBadge,
    title: t.carousel.houseTitle,
    subtitle: t.carousel.houseSubtitle,
    description: t.carousel.houseDesc,
    ctaPrimary: { label: t.carousel.houseCta, href: 'https://boeken.edstruijlaart.nl', external: true },
    image: huiskamerImage,
    imageAlt: 'Ed Struijlaart speelt een huiskamerconcert',
    youtubeId: 'luQq4YDNJ_c',
  },
];
---

<div
  class="highlight-carousel"
  role="region"
  aria-roledescription="carousel"
  aria-label={t.carousel.highlights}
  data-slide-text={t.carousel.goToSlide}
  data-of-text={t.carousel.slideOf}
  tabindex="0"
>
  {/* Slides wrapper */}
  <div class="carousel-slides relative overflow-hidden">
    {slides.map((slide, i) => (
      <div
        class:list={[
          'highlight-slide',
          i === 0 ? 'is-active' : 'is-hidden',
        ]}
        role="group"
        aria-roledescription="slide"
        aria-label={`${t.carousel.goToSlide} ${i + 1} ${t.carousel.slideOf} ${slides.length}`}
        aria-hidden={i !== 0 ? 'true' : 'false'}
      >
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
          {/* Visual - alle afbeeldingen in aspect-video zodat slides gelijke hoogte hebben */}
          <div class="rounded-lg overflow-hidden aspect-video" style="box-shadow: var(--shadow-card);">
            {slide.youtubeId ? (
              <div
                class="youtube-lite relative cursor-pointer group w-full h-full"
                data-youtube-id={slide.youtubeId}
                data-youtube-title={slide.imageAlt}
                role="button"
                aria-label={t.carousel.playVideo}
              >
                <Image
                  src={slide.image}
                  alt={slide.imageAlt}
                  widths={[400, 640, 800]}
                  sizes="(max-width: 1024px) 100vw, 50vw"
                  class="w-full h-full object-cover"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
                <div class="absolute inset-0 flex items-center justify-center bg-black/20 group-hover:bg-black/30 transition-colors duration-300">
                  <div class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-[var(--color-gold)] flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-7 h-7 md:w-8 md:h-8 text-white ml-1" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                </div>
              </div>
            ) : (
              <Image
                src={slide.image}
                alt={slide.imageAlt}
                widths={[400, 540, 800]}
                sizes="(max-width: 1024px) 100vw, 50vw"
                class="w-full h-full object-cover"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            )}
          </div>

          {/* Tekst */}
          <div>
            <span class="inline-block px-3 py-1 rounded-full text-sm font-medium bg-[var(--color-gold)]/10 text-[var(--color-gold)] mb-4">
              {slide.badge}
            </span>
            <h2 class="font-[var(--font-display)] text-4xl lg:text-5xl">
              {slide.title}
            </h2>
            {slide.subtitle && (
              <p class="mt-2 font-[var(--font-display)] text-2xl text-[var(--color-gold)]">
                {slide.subtitle}
              </p>
            )}
            <p class="mt-4 text-lg" style="color: var(--fg-muted);">
              {slide.description}
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <Button
                href={slide.ctaPrimary.href}
                variant="primary"
                target={slide.ctaPrimary.external ? '_blank' : undefined}
                rel={slide.ctaPrimary.external ? 'noopener noreferrer' : undefined}
              >
                {slide.ctaPrimary.label}
              </Button>
              {slide.ctaSecondary && (
                <Button
                  href={slide.ctaSecondary.href}
                  variant="outline"
                  target={slide.ctaSecondary.external ? '_blank' : undefined}
                  rel={slide.ctaSecondary.external ? 'noopener noreferrer' : undefined}
                >
                  {slide.ctaSecondary.label}
                </Button>
              )}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  {/* Dot navigatie */}
  <div class="flex justify-center gap-2 mt-8" role="tablist" aria-label={t.carousel.slideNav}>
    {slides.map((_, i) => (
      <button
        class:list={[
          'highlight-dot h-2 rounded-full transition-all duration-300',
          i === 0 ? 'bg-[var(--color-gold)] w-6' : 'bg-[var(--color-gold)]/30 w-2',
        ]}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-label={`${t.carousel.goToSlide} ${i + 1}`}
      />
    ))}
  </div>

  {/* Screen reader live regio */}
  <div class="sr-only highlight-live" aria-live="polite" aria-atomic="true">
    {t.carousel.goToSlide} 1 {t.carousel.slideOf} {slides.length}
  </div>
</div>

<style>
  /* Eerste slide bepaalt de hoogte, rest is absolute erboven */
  .highlight-slide.is-active {
    position: relative;
    opacity: 1;
    z-index: 1;
    transition: opacity 700ms ease-in-out;
  }

  .highlight-slide.is-hidden {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    pointer-events: none;
    z-index: 0;
    transition: opacity 700ms ease-in-out;
  }
</style>

<script>
  function initHighlightCarousel() {
    const container = document.querySelector<HTMLElement>('.highlight-carousel');
    if (!container) return;

    const slides = container.querySelectorAll<HTMLElement>('.highlight-slide');
    const dots = container.querySelectorAll<HTMLElement>('.highlight-dot');
    if (slides.length <= 1) return;

    let current = 0;
    const total = slides.length;
    const INTERVAL = 7500;
    let isPaused = false;
    let videoPlaying = false;

    function goTo(index: number) {
      // Stop eventuele video in huidige slide
      const iframe = slides[current].querySelector('iframe');
      if (iframe) {
        const litEl = iframe.closest('.youtube-lite') || iframe.parentElement;
        if (litEl) {
          const original = litEl.getAttribute('data-original-html');
          if (original) litEl.innerHTML = original;
        }
        videoPlaying = false;
      }

      // Verberg huidige slide
      slides[current].classList.remove('is-active');
      slides[current].classList.add('is-hidden');
      slides[current].setAttribute('aria-hidden', 'true');

      dots[current].classList.remove('bg-[var(--color-gold)]', 'w-6');
      dots[current].classList.add('bg-[var(--color-gold)]/30', 'w-2');
      dots[current].setAttribute('aria-selected', 'false');

      current = index;

      // Toon nieuwe slide
      slides[current].classList.remove('is-hidden');
      slides[current].classList.add('is-active');
      slides[current].setAttribute('aria-hidden', 'false');

      dots[current].classList.remove('bg-[var(--color-gold)]/30', 'w-2');
      dots[current].classList.add('bg-[var(--color-gold)]', 'w-6');
      dots[current].setAttribute('aria-selected', 'true');

      // Update live regio
      const liveRegion = container.querySelector('.highlight-live');
      if (liveRegion) {
        const slideText = container.getAttribute('data-slide-text') || 'Ga naar slide';
        const ofText = container.getAttribute('data-of-text') || 'van';
        liveRegion.textContent = `${slideText} ${current + 1} ${ofText} ${total}`;
      }
    }

    // Auto-advance
    let timer = setInterval(() => {
      if (!isPaused && !videoPlaying) goTo((current + 1) % total);
    }, INTERVAL);

    function resetTimer() {
      videoPlaying = false;
      clearInterval(timer);
      timer = setInterval(() => {
        if (!isPaused && !videoPlaying) goTo((current + 1) % total);
      }, INTERVAL);
    }

    // Pause on hover
    container.addEventListener('mouseenter', () => { isPaused = true; });
    container.addEventListener('mouseleave', () => { if (!videoPlaying) isPaused = false; });

    // Dot klik navigatie
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        goTo(i);
        resetTimer();
      });
    });

    // Keyboard navigatie
    container.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goTo((current - 1 + total) % total);
        resetTimer();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        goTo((current + 1) % total);
        resetTimer();
      }
    });

    // Touch swipe
    let touchStartX = 0;
    const SWIPE_THRESHOLD = 50;

    container.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
      isPaused = true;
    }, { passive: true });

    container.addEventListener('touchend', (e: TouchEvent) => {
      const touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > SWIPE_THRESHOLD) {
        if (diff > 0) {
          goTo((current + 1) % total);
        } else {
          goTo((current - 1 + total) % total);
        }
        resetTimer();
      }
      isPaused = false;
    }, { passive: true });

    // YouTube lite-embed
    container.querySelectorAll<HTMLElement>('.youtube-lite').forEach(el => {
      // Bewaar originele HTML voor herstel bij slide-wissel
      el.setAttribute('data-original-html', el.innerHTML);

      el.addEventListener('click', () => {
        // Niet opnieuw embedden als iframe al actief is
        if (el.querySelector('iframe')) return;
        const id = el.dataset.youtubeId;
        if (!id) return;
        videoPlaying = true;
        isPaused = true;
        clearInterval(timer);
        const title = el.dataset.youtubeTitle || 'Video';
        el.innerHTML = `<iframe
          src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0"
          class="w-full h-full rounded-lg"
          allow="autoplay; encrypted-media"
          allowfullscreen
          title="${title}"
          style="border: 0;"
        ></iframe>`;
      });
    });
  }

  initHighlightCarousel();
  document.addEventListener('astro:after-swap', initHighlightCarousel);
</script>
