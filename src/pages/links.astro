  { name: "Facebook", href: "https://facebook.com/edstruijlaartofficial", event: "social-facebook",
    path: "M24 12a12 12 0 10-13.88 11.85v-8.38H7.08V12h3.04V9.36c0-3 1.79-4.67 4.53-4.67 1.31 0 2.69.24 2.69.24v2.95h-1.51c-1.49 0-1.96.93-1.96 1.87V12h3.33l-.53 3.47h-2.8v8.38A12 12 0 0024 12z" },
];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href="https://edstruijlaart.nl/links" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://edstruijlaart.nl/links" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="https://edstruijlaart.nl/images/links/ed-avatar.jpg" />
    <meta property="og:locale" content="nl_NL" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Analytics (Umami, cookieless) -->
    <script defer src="https://analytics.earswantmusic.nl/script.js" data-website-id="98cc05e1-4825-4c78-a94a-e823227f0cc3"></script>

    <!-- Ad-pixels (Meta + Google) voor retargeting -->
    <AdPixels />

    <style>
      .links, .links *, .links *::before, .links *::after {
        box-sizing: border-box; margin: 0; padding: 0;
      }
      .links {
        --bg: #0e0e0d;
        --card: rgba(255,255,255,0.05);
        --border: rgba(255,255,255,0.12);
        --gold: #b8860b;
        --gold-light: #d4a836;
        --white: #ffffff;
        --muted: rgba(255,255,255,0.62);
        --font-display: "Barlow Condensed", "Arial Narrow", Arial, sans-serif;
        --font-body: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
        font-family: var(--font-body);
        color: var(--white);
        min-height: 100svh;
        background:
          radial-gradient(circle at 50% 0%, rgba(184,134,11,0.16), transparent 55%),
          var(--bg);
        -webkit-font-smoothing: antialiased;
      }
      .links a { color: inherit; text-decoration: none; }
      .links img { display: block; max-width: 100%; }

      .links .wrap {
        max-width: 520px;
        margin: 0 auto;
        padding: clamp(2.5rem, 8vw, 4rem) 1.25rem 3rem;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .links .avatar {
        width: 116px; height: 116px; border-radius: 50%;
        overflow: hidden; border: 3px solid var(--gold);
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      }
      .links .avatar img { width: 100%; height: 100%; object-fit: cover; }

      .links .name {
        font-family: var(--font-display); font-weight: 800;
        font-size: 2.1rem; letter-spacing: 0.01em; text-transform: uppercase;
        margin-top: 1.1rem; line-height: 1;
      }
      .links .tagline {
        color: var(--muted); font-size: 0.92rem; margin-top: 0.6rem;
        text-align: center; letter-spacing: 0.02em;
      }

      .links .stack {
        width: 100%; display: flex; flex-direction: column; gap: 0.8rem;
        margin-top: 2rem;
      }
      .links .btn {
        display: block; width: 100%; text-align: center;
        background: var(--card); border: 1px solid var(--border);
        border-radius: 12px; padding: 0.95rem 1rem;
        transition: transform 0.15s, border-color 0.2s, background 0.2s;
      }
      .links .btn:hover { transform: translateY(-2px); border-color: var(--gold); background: rgba(184,134,11,0.10); }
      .links .btn .btn-label {
        font-family: var(--font-display); font-weight: 700;
        font-size: 1.18rem; letter-spacing: 0.02em; text-transform: uppercase;
      }
      .links .btn .btn-sub { display: block; color: var(--muted); font-size: 0.82rem; margin-top: 0.15rem; }

      .links .btn.featured {
        background: var(--gold); border-color: var(--gold);
        box-shadow: 0 8px 24px rgba(184,134,11,0.35);
      }
      .links .btn.featured:hover { background: var(--gold-light); border-color: var(--gold-light); }
      .links .btn.featured .btn-label,
      .links .btn.featured .btn-sub { color: #1a1407; }
      .links .btn.featured .btn-sub { opacity: 0.8; }

      .links .socials {
        display: flex; gap: 1.4rem; margin-top: 2.2rem;
      }
      .links .socials a {
        color: var(--muted); transition: color 0.2s, transform 0.15s;
        display: inline-flex;
      }
      .links .socials a:hover { color: var(--gold-light); transform: translateY(-2px); }
      .links .socials svg { width: 26px; height: 26px; }

      .links .foot { margin-top: 2.4rem; color: rgba(255,255,255,0.4); font-size: 0.8rem; letter-spacing: 0.04em; }
    </style>
  </head>

  <body style="margin:0; background:#0e0e0d;">
    <main class="links">
      <div class="wrap">
        <div class="avatar">
          <picture>
            <source srcset="/images/links/ed-avatar.webp" type="image/webp" />
            <img src="/images/links/ed-avatar.jpg" alt="Ed Struijlaart" width="116" height="116" loading="eager" />
          </picture>
        </div>
        <h1 class="name">Ed Struijlaart</h1>
        <p class="tagline">Gitarist · Singer-songwriter · Podcast · Theater</p>

        <nav class="stack">
          {buttons.map((b) => (
            <a
              class:list={["btn", { featured: b.featured }]}
              href={b.href}
              target={b.href.startsWith("/") ? undefined : "_blank"}
              rel={b.href.startsWith("/") ? undefined : "noopener"}
              data-umami-event={b.event}
            >
              <span class="btn-label">{b.label}</span>
              {b.sub && <span class="btn-sub">{b.sub}</span>}
            </a>
          ))}
        </nav>

        <div class="socials">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.name} data-umami-event={s.event}>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
            </a>
          ))}
        </div>

        <p class="foot">edstruijlaart.nl</p>
      </div>
    </main>
  </body>
</html>
