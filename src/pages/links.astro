---
export const prerender = true;

import AdPixels from "../components/AdPixels.astro";

// Link-in-bio hub voor edstruijlaart.nl (de "link in bio" van Instagram e.d.).
// Zelf-gehost i.p.v. Linktree. Marketing-laag:
//  - AdPixels (Meta+Google) = retargeting-pool van elke bezoeker
//  - Umami event per link-klik + Meta custom events (intentie-segmenten)
//  - per-link UTM (attributie in Tour Insights / continuum-pixel)
//  - geo-gepersonaliseerde ticketknop (dichtstbijzijnde GM4-show, via /api/geo-show)
//  - inline e-mailcapture onder de knoppen (lijstgroei + AFAS-funnel, /api/subscribe-afas)
// Alle CSS gescoped onder .links (bare :root/body lekken site-breed in Astro).

const pageTitle = "Ed Struijlaart — alle links";
const pageDescription =
  "Continuum Day, tickets voor Gitaarmannen 4: Continuum, mijn gratis AFAS Live concert, huiskamerconcerten, de podcast en mijn muziek. Alles op een plek.";

// Per-link UTM zodat je doorkliks kunt toeschrijven (Umami + continuum-pixel).
function withUtm(href: string, campaign: string): string {
  const sep = href.includes("?") ? "&" : "?";
  return `${href}${sep}utm_source=links&utm_medium=bio&utm_campaign=${campaign}`;
}

// Volgorde = prioriteit. featured = de grote gouden knop bovenaan.
const buttons = [
  {
    featured: true,
    label: "Gitaarmannen 4: Continuum — tickets",
    sub: "Mijn nieuwe theatertour, najaar 2026",
    href: "https://www.gitaarmannen.nl/continuum/",
    event: "link-continuum",
  },
  {
    label: "Continuum Day — 12 september",
    sub: "Speel of zing mee bij Beeld & Geluid en win een PRS Silver Sky",
    href: "https://www.gitaarmannen.nl/continuum-day",
    event: "link-continuum-day",
  },
  {
    label: "Gratis: mijn hele AFAS Live concert",
    sub: "Het voorprogramma van de Gipsy Kings, cadeau",
    href: "/afas",
    event: "link-afas",
  },
  {
    label: "Gratis: Gitaarmannen 3 — John Mayer",
    sub: "De hele theatershow, gratis te kijken",
    href: "https://www.gitaarmannen.nl/john-mayer",
    event: "link-gm3",
  },
  {
    label: "Boek een huiskamerconcert",
    sub: "Ik kom bij je thuis spelen",
    href: "/huiskamerconcerten/",
    event: "link-huiskamer",
  },
  {
    label: "Gitaarmannen op YouTube",
    sub: "De podcast met mijn favoriete gitaristen",
    href: "https://www.youtube.com/@EdStruijlaart/videos",
    event: "link-gitaarmannen-yt",
  },
  {
    label: "Mijn muziek op Spotify",
    sub: "Mijn eigen nummers",
    href: "https://open.spotify.com/artist/08cpwYrPWo8Xkxl9qdiDP2",
    event: "link-muziek",
  },
];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href="https://edstruijlaart.nl/links" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://edstruijlaart.nl/links" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="https://edstruijlaart.nl/images/links/ed-avatar.jpg" />
    <meta property="og:locale" content="nl_NL" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Analytics (Umami, cookieless) -->
    <script defer src="https://analytics.earswantmusic.nl/script.js" data-website-id="98cc05e1-4825-4c78-a94a-e823227f0cc3"></script>

    <!-- Ad-pixels (Meta + Google) voor retargeting -->
    <AdPixels />

    <style>
      .links, .links *, .links *::before, .links *::after {
        box-sizing: border-box; margin: 0; padding: 0;
      }
      .links {
        --bg: #0e0e0d;
        --card: rgba(255,255,255,0.05);
        --border: rgba(255,255,255,0.12);
        --gold: #00aacc;
        --gold-light: #33c6e8;
        --white: #ffffff;
        --muted: rgba(255,255,255,0.62);
        --font-display: "Barlow Condensed", "Arial Narrow", Arial, sans-serif;
        --font-body: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
        font-family: var(--font-body);
        color: var(--white);
        min-height: 100svh;
        position: relative;
        background: var(--bg);
        -webkit-font-smoothing: antialiased;
      }
      .links a { color: inherit; text-decoration: none; }
      .links img { display: block; max-width: 100%; }

      /* Vaste, geblurde persfoto-achtergrond + donkere gradient + gouden gloed */
      .links .bg { position: fixed; inset: 0; z-index: 0; }
      .links .bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 28%; }
      .links .bg::after {
        content: ""; position: absolute; inset: 0;
        background:
          radial-gradient(circle at 50% 2%, rgba(0,170,204,0.22), transparent 52%),
          linear-gradient(180deg, rgba(14,14,13,0.70) 0%, rgba(14,14,13,0.88) 52%, rgba(14,14,13,0.97) 100%);
      }

      .links .wrap {
        position: relative;
        z-index: 1;
        max-width: 520px;
        margin: 0 auto;
        padding: clamp(2.5rem, 8vw, 4rem) 1.25rem 3rem;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .links .avatar {
        width: 116px; height: 116px; border-radius: 50%;
        overflow: hidden; border: 3px solid var(--gold);
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      }
      .links .avatar img { width: 100%; height: 100%; object-fit: cover; }

      .links .name {
        font-family: var(--font-display); font-weight: 800;
        font-size: 2.1rem; letter-spacing: 0.01em; text-transform: uppercase;
        margin-top: 1.1rem; line-height: 1;
      }
      .links .tagline {
        color: var(--muted); font-size: 0.92rem; margin-top: 0.6rem;
        text-align: center; letter-spacing: 0.02em;
      }

      .links .stack {
        width: 100%; display: flex; flex-direction: column; gap: 0.8rem;
        margin-top: 2rem;
      }
      .links .btn {
        display: block; width: 100%; text-align: center;
        background: var(--card); border: 1px solid var(--border);
        border-radius: 12px; padding: 0.95rem 1rem;
        transition: transform 0.15s, border-color 0.2s, background 0.2s;
      }
      .links .btn:hover { transform: translateY(-2px); border-color: var(--gold); background: rgba(0,170,204,0.10); }
      .links .btn .btn-label {
        font-family: var(--font-display); font-weight: 700;
        font-size: 1.18rem; letter-spacing: 0.02em; text-transform: uppercase;
      }
      .links .btn .btn-sub { display: block; color: var(--muted); font-size: 0.82rem; margin-top: 0.15rem; }

      .links .btn.featured {
        background: var(--gold); border-color: var(--gold);
        box-shadow: 0 8px 24px rgba(0,170,204,0.35);
        animation: spotlight 2.8s ease-in-out infinite;
      }
      .links .btn.featured:hover { background: var(--gold-light); border-color: var(--gold-light); }
      .links .btn.featured .btn-label,
      .links .btn.featured .btn-sub { color: #06232b; }
      .links .btn.featured .btn-sub { opacity: 0.85; }
      @keyframes spotlight {
        0%, 100% { box-shadow: 0 8px 24px rgba(0,170,204,0.32); }
        50% { box-shadow: 0 10px 40px rgba(0,170,204,0.62); }
      }
      @media (prefers-reduced-motion: reduce) {
        .links .btn.featured { animation: none; }
        .links .btn { transition: none; }
      }

      /* Inline e-mailcapture (onder de knoppen, vangt de afhakers) */
      .links .capture {
        width: 100%; margin-top: 2rem;
        background: rgba(255,255,255,0.04); border: 1px solid var(--border);
        border-radius: 12px; padding: 1.15rem 1.05rem; text-align: center;
      }
      .links .capture h2 {
        font-family: var(--font-display); font-weight: 700; font-size: 1.1rem;
        text-transform: uppercase; letter-spacing: 0.03em;
      }
      .links .capture p.lead { color: var(--muted); font-size: 0.83rem; margin: 0.25rem 0 0.8rem; line-height: 1.45; }
      .links .capture form { display: flex; gap: 0.5rem; }
      .links .capture input {
        flex: 1; min-width: 0; padding: 0.72rem 0.85rem;
        background: rgba(255,255,255,0.06); border: 1px solid var(--border);
        border-radius: 8px; color: var(--white); font-size: 0.95rem; font-family: var(--font-body);
      }
      .links .capture input::placeholder { color: rgba(255,255,255,0.4); }
      .links .capture input:focus { outline: none; border-color: var(--gold); }
      .links .capture button {
        background: var(--gold); color: #06232b; border: none; border-radius: 8px;
        padding: 0 1.05rem; font-family: var(--font-display); font-weight: 800;
        text-transform: uppercase; font-size: 0.92rem; letter-spacing: 0.03em;
        cursor: pointer; white-space: nowrap; transition: background 0.2s;
      }
      .links .capture button:hover { background: var(--gold-light); }
      .links .capture button:disabled { opacity: 0.6; cursor: wait; }
      .links .capture .micro { color: rgba(255,255,255,0.4); font-size: 0.72rem; margin-top: 0.55rem; }
      .links .capture .err { color: #ff9b9b; font-size: 0.8rem; margin-top: 0.45rem; display: none; }
      .links .capture.done .lead { color: var(--gold-light); }

      .links .foot { margin-top: 2.2rem; color: rgba(255,255,255,0.4); font-size: 0.8rem; letter-spacing: 0.04em; }
    </style>
  </head>

  <body style="margin:0; background:#0e0e0d;">
    <main class="links">
      <div class="bg" aria-hidden="true">
        <picture>
          <source srcset="/images/links/bg.webp" type="image/webp" />
          <img src="/images/links/bg.jpg" alt="" loading="eager" />
        </picture>
      </div>
      <div class="wrap">
        <div class="avatar">
          <picture>
            <source srcset="/images/links/ed-avatar.webp" type="image/webp" />
            <img src="/images/links/ed-avatar.jpg" alt="Ed Struijlaart" width="116" height="116" loading="eager" />
          </picture>
        </div>
        <h1 class="name">Ed Struijlaart</h1>
        <p class="tagline">Gitarist · Singer-songwriter · Podcast · Theater</p>

        <nav class="stack">
          {buttons.map((b) => {
            const isExternal = !b.href.startsWith("/");
            const href = withUtm(b.href, b.event.replace("link-", ""));
            return (
              <a
                class:list={["btn", { featured: b.featured }]}
                href={href}
                target={isExternal ? "_blank" : undefined}
                rel={isExternal ? "noopener" : undefined}
                data-umami-event={b.event}
              >
                <span class="btn-label">{b.label}</span>
                {b.sub && <span class="btn-sub">{b.sub}</span>}
              </a>
            );
          })}
        </nav>

        <div class="capture" id="capture">
          <h2>Niks missen?</h2>
          <p class="lead">Laat je mail achter, dan stuur ik je gratis mijn hele AFAS Live concert en hoor je als eerste over nieuwe shows.</p>
          <form id="capture-form">
            <input type="email" id="capture-email" name="email" placeholder="jij@email.nl" required autocomplete="email" />
            <button type="submit">Stuur 'm</button>
          </form>
          <p class="err" id="capture-error"></p>
          <p class="micro">Geen spam. Uitschrijven kan altijd met een klik.</p>
        </div>

        <p class="foot">edstruijlaart.nl</p>
      </div>
    </main>

    <script>
      // Geo-personalisatie + inline capture + scherpere klik-tracking.
      let geoProvincie = null;

      // 1) Dichtstbijzijnde GM4-show in de featured knop tonen (client-side,
      //    pagina blijft statisch/cachebaar). Valt stil terug op de generieke knop.
      (async () => {
        try {
          const r = await fetch("/api/geo-show");
          if (!r.ok) return;
          const d = await r.json();
          if (d.provincie) geoProvincie = d.provincie;
          if (d.show) {
            const sub = document.querySelector(".links .btn.featured .btn-sub");
            if (sub) sub.textContent = "Het dichtst bij jou: " + d.show.city + ", " + d.show.dateLabel;
            const a = document.querySelector(".links .btn.featured");
            if (a) {
              try {
                const u = new URL(a.href);
                u.searchParams.set("utm_content", d.show.city);
                a.setAttribute("href", u.toString());
              } catch (e) {}
            }
          }
        } catch (e) {}
      })();

      // 2) Meta custom events per klik (Umami doet de data-umami-event vanzelf).
      document.querySelectorAll(".links .btn").forEach((a) => {
        a.addEventListener("click", () => {
          const ev = a.getAttribute("data-umami-event") || "link";
          try {
            if (window.fbq) {
              const naam = ev === "link-continuum" ? "ClickTickets"
                : ev === "link-continuum-day" ? "ClickContinuumDay"
                : "LinkClick";
              fbq("trackCustom", naam, { link: ev });
            }
          } catch (e) {}
        });
      });

      // 3) Inline e-mailcapture -> AFAS-funnel (Listmonk + bedankmail).
      const capForm = document.getElementById("capture-form");
      const capBox = document.getElementById("capture");
      const capErr = document.getElementById("capture-error");
      capForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (capErr) capErr.style.display = "none";
        const email = document.getElementById("capture-email").value.trim();
        const btn = capForm.querySelector("button");
        const orig = btn.textContent;
        btn.disabled = true;
        btn.textContent = "...";
        try {
          const res = await fetch("/api/subscribe-afas", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, provincie: geoProvincie }),
          });
          if (res.ok) {
            capBox.classList.add("done");
            capBox.innerHTML =
              "<h2>Top!</h2><p class=\"lead\">Check je mail, het concert komt eraan. Veel kijkplezier.</p>";
            try { if (window.umami) umami.track("links-capture", { provincie: geoProvincie || "onbekend" }); } catch (e) {}
            try { if (window.fbq) fbq("track", "Lead", { content_name: "links inline capture" }); } catch (e) {}
          } else {
            const d = await res.json().catch(() => ({}));
            if (capErr) { capErr.textContent = d.error || "Er ging iets mis, probeer het zo nog eens."; capErr.style.display = "block"; }
            btn.disabled = false; btn.textContent = orig;
          }
        } catch (err) {
          if (capErr) { capErr.textContent = "Geen verbinding, probeer het zo nog eens."; capErr.style.display = "block"; }
          btn.disabled = false; btn.textContent = orig;
        }
      });
    </script>
  </body>
</html>
