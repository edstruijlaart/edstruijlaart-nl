  { name: "YouTube", href: "https://youtube.com/@edstruijlaart", event: "social-youtube",
    path: "M23.5 6.2a3.02 3.02 0 00-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.51A3.02 3.02 0 00.5 6.2C0 8.07 0 12 0 12s0 3.93.5 5.8a3.02 3.02 0 002.12 2.14c1.88.51 9.38.51 9.38.51s7.5 0 9.38-.51a3.02 3.02 0 002.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z" },
  { name: "Spotify", href: "https://open.spotify.com/artist/08cpwYrPWo8Xkxl9qdiDP2", event: "social-spotify",
