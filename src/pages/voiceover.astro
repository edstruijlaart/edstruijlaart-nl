---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import portraitImage from '../assets/photos/ed-struijlaart-recent-2025.jpg';
---

<BaseLayout
  title="Nederlandse Voice-over Inhuren | Mannelijke Stem"
  description="Nederlandse mannelijke voice-over inhuren? Ed Struijlaart is de stem achter Corendon, Danerolles, Fitzroy en MORE. Eigen thuisstudio, dezelfde dag geleverd. Vraag nu een offerte aan."
  ogImage="/images/vo/og-voiceover.jpg"
>
  <!-- JSON-LD: Service schema -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Voice-over Ed Struijlaart",
      "provider": {
        "@type": "Person",
        "name": "Ed Struijlaart",
        "url": "https://edstruijlaart.nl"
      },
      "serviceType": "Nederlandse mannelijke voice-over",
      "description": "Professionele Nederlandse mannelijke voice-over inhuren voor commercials, bedrijfsfilms, e-learning en luisterboeken. Stemacteur met eigen thuisstudio en snelle levering.",
      "areaServed": {
        "@type": "Country",
        "name": "NL"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Voice-over diensten",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Voice-over commercials" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Voice-over bedrijfsfilm" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Voice-over e-learning" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Luisterboek inspreken" } }
        ]
      },
      "url": "https://edstruijlaart.nl/voiceover/"
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wat kost een voice-over?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "De prijs hangt af van het type project, de lengte van het script en het gebruiksdoel. Stuur je briefing via het formulier en je ontvangt binnen 2 uur een offerte op maat."
          }
        },
        {
          "@type": "Question",
          "name": "Hoe snel kan ik een voice-over laten inspreken?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dankzij een eigen thuisstudio kan Ed snel schakelen. Bij een briefing in de ochtend heb je de audio dezelfde dag nog. Spoedopdrachten zijn geen probleem."
          }
        },
        {
          "@type": "Question",
          "name": "Voor welk type projecten kan ik een voice-over boeken?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Commercials (TV, radio, online), bedrijfsfilms, e-learning modules, luisterboeken, animaties, telefoonsystemen en meer. Van corporate tot creatief, van zakelijk tot speels."
          }
        },
        {
          "@type": "Question",
          "name": "In welke talen spreek je in?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ed werkt voornamelijk als Nederlandse voice-over, maar spreekt ook Engelse scripts in. Veel klanten zijn internationale merken die een Nederlandse mannelijke stem zoeken."
          }
        },
        {
          "@type": "Question",
          "name": "Wat is het verschil met een AI-stem?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Een menselijke stemacteur brengt emotie, timing en nuance die AI niet kan repliceren. Met een achtergrond in radio en theater weet Ed precies hoe hij een script tot leven brengt. 100% menselijk, 100% karakter."
          }
        }
      ]
    })} />
  </Fragment>

  <!-- ============================================
       HERO — video background
       ============================================ -->
  <section class="relative overflow-hidden min-h-[85vh] flex items-center">
    <!-- Video background -->
    <video
      id="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/images/vo/manley-studio.jpg"
      class="absolute inset-0 w-full h-full object-cover"
    >
      <source src="/audio/vo/ed-struijlaart-fiverr-intro.mp4" type="video/mp4" />
    </video>

    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/30"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-black/20"></div>

    <!-- Content -->
    <div class="relative z-10 mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-32 lg:py-40">
      <div class="max-w-2xl">
        <p class="text-sm font-medium uppercase tracking-widest mb-4" style="color: var(--color-gold);">
          Voice-over &amp; Stemacteur
        </p>
        <h1 class="font-[var(--font-display)] text-4xl sm:text-5xl lg:text-6xl leading-[1.05] text-white">
          Een stem die<br />
          <span style="color: var(--color-gold);">opvalt</span> en<br />
          blijft hangen
        </h1>
        <p class="mt-6 text-lg leading-relaxed max-w-lg text-white/80">
          Nederlandse mannelijke voice-over. De stem achter Corendon, Danerolles, Fitzroy, MORE en Locally Made.
          Eigen thuisstudio, dezelfde dag geleverd.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="#boeken"
            class="inline-flex items-center justify-center font-medium rounded-full transition-all duration-300 active:scale-[0.97] btn-primary bg-[var(--color-gold)] text-white hover:bg-[var(--color-gold-light)] active:bg-[var(--color-gold-dark)] px-8 py-4 text-base"
          >
            Direct boeken
          </a>
          <a
            href="#portfolio"
            class="inline-flex items-center justify-center font-medium rounded-full transition-all duration-300 active:scale-[0.97] border-2 border-white/40 text-white hover:bg-white/10 px-8 py-4 text-base"
          >
            Beluister voorbeelden
          </a>
        </div>

        <!-- Beschikbaar badge -->
        <div class="mt-8 inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium bg-white/10 backdrop-blur-sm text-white/90 border border-white/10">
          <span class="inline-block w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
          Vandaag beschikbaar
        </div>
      </div>
    </div>

    <!-- Unmute knop -->
    <button
      id="hero-unmute"
      class="absolute bottom-6 right-6 z-10 flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium bg-white/10 backdrop-blur-sm text-white/80 border border-white/10 hover:bg-white/20 transition-all duration-300 cursor-pointer"
      aria-label="Geluid aan/uit"
    >
      <svg id="icon-muted" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
      </svg>
      <svg id="icon-unmuted" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072M18.364 5.636a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
      </svg>
      <span id="mute-label">Geluid aan</span>
    </button>
  </section>

  <!-- ============================================
       CLIENT LOGOS
       ============================================ -->
  <section class="py-12 border-y" style="border-color: var(--bg-surface);">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
      <p class="text-center text-sm uppercase tracking-widest mb-8" style="color: var(--fg-muted);">
        Vertrouwd door
      </p>
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-16">
        <img
          src="/images/vo/corendon.png"
          alt="Corendon"
          class="h-10 md:h-12 w-auto object-contain grayscale opacity-60 hover:opacity-80 transition-all duration-300 dark:invert dark:brightness-200"
          loading="lazy"
        />
        <img
          src="/images/vo/danerolles.png"
          alt="Danerolles"
          class="h-10 md:h-12 w-auto object-contain grayscale opacity-60 hover:opacity-80 transition-all duration-300 dark:invert dark:brightness-200"
          loading="lazy"
        />
        <img
          src="/images/vo/smeerkees.png"
          alt="Smeerkees"
          class="h-10 md:h-12 w-auto object-contain grayscale opacity-60 hover:opacity-80 transition-all duration-300 dark:invert dark:brightness-200"
          loading="lazy"
        />
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 70" fill="currentColor" class="h-10 md:h-12 w-auto opacity-50 hover:opacity-70 transition-all duration-300" role="img" aria-label="Fitzroy">
          <text x="60" y="30" font-family="Impact, 'Arial Narrow', 'Helvetica Neue', sans-serif" font-size="34" font-weight="900" letter-spacing="2" text-anchor="middle" font-stretch="condensed">FITZ</text>
          <text x="60" y="62" font-family="Impact, 'Arial Narrow', 'Helvetica Neue', sans-serif" font-size="34" font-weight="900" letter-spacing="2" text-anchor="middle" font-stretch="condensed">ROY</text>
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 55" fill="currentColor" class="h-10 md:h-12 w-auto opacity-50 hover:opacity-70 transition-all duration-300" role="img" aria-label="MORE">
          <text x="72" y="42" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="44" font-weight="900" font-style="italic" text-anchor="middle">more</text>
          <text x="138" y="20" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="12" font-weight="700">®</text>
        </svg>
        <img
          src="/images/vo/locally-made.png"
          alt="Locally Made"
          class="h-10 md:h-12 w-auto object-contain grayscale opacity-60 hover:opacity-80 transition-all duration-300 dark:invert dark:brightness-200"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ============================================
       USPs
       ============================================ -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
        <!-- USP 1 -->
        <div class="text-center md:text-left">
          <div
            class="inline-flex items-center justify-center w-14 h-14 rounded-xl mb-5"
            style="background-color: rgba(184, 134, 11, 0.1);"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" style="color: var(--color-gold);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
          </div>
          <h3 class="font-[var(--font-display)] text-2xl mb-3">Snel geleverd</h3>
          <p class="text-base leading-relaxed" style="color: var(--fg-muted);">
            Eigen thuisstudio, altijd stand-by. Briefing 's ochtends, audio 's middags.
            Geen wachttijden, geen studio huren. Dezelfde dag in je inbox.
          </p>
        </div>

        <!-- USP 2 -->
        <div class="text-center md:text-left">
          <div
            class="inline-flex items-center justify-center w-14 h-14 rounded-xl mb-5"
            style="background-color: rgba(184, 134, 11, 0.1);"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" style="color: var(--color-gold);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
            </svg>
          </div>
          <h3 class="font-[var(--font-display)] text-2xl mb-3">Karakter</h3>
          <p class="text-base leading-relaxed" style="color: var(--fg-muted);">
            Niet de zoveelste inwisselbare stem. Warm, eigengereid, met een achtergrond
            in radio, theater en muziek. Een stem die iets te vertellen heeft.
          </p>
        </div>

        <!-- USP 3 -->
        <div class="text-center md:text-left">
          <div
            class="inline-flex items-center justify-center w-14 h-14 rounded-xl mb-5"
            style="background-color: rgba(184, 134, 11, 0.1);"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" style="color: var(--color-gold);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
            </svg>
          </div>
          <h3 class="font-[var(--font-display)] text-2xl mb-3">Veelzijdig</h3>
          <p class="text-base leading-relaxed" style="color: var(--fg-muted);">
            Commercials, bedrijfsfilms, e-learning, luisterboeken, stemacteur.
            Van speels en energiek tot warm en vertrouwd. Altijd op maat.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       STUDIO VISUAL
       ============================================ -->
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-[1400px]">
      <div class="relative">
        <img
          src="/images/vo/manley-studio.jpg"
          alt="Ed Struijlaart's thuisstudio met Manley Reference microfoon en DaVinci Resolve"
          class="w-full h-[300px] md:h-[450px] lg:h-[550px] object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-6 md:p-10">
          <p class="text-white/90 text-lg md:text-xl font-medium">Eigen thuisstudio</p>
          <p class="text-white/60 text-sm md:text-base mt-1">Manley Reference · DaVinci Resolve Studio · Akoestisch behandeld</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       PORTFOLIO
       ============================================ -->
  <section id="portfolio" class="py-20 md:py-28" style="background-color: var(--bg-surface);">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-[var(--font-display)] text-4xl">Bekijk &amp; beluister</h2>
        <div class="mt-4 h-1 w-12 rounded-full mx-auto" style="background: linear-gradient(90deg, var(--color-gold-dark), var(--color-gold), var(--color-gold-light));"></div>
        <p class="mt-4 text-lg max-w-2xl mx-auto" style="color: var(--fg-muted);">
          Van TV-commercials en bedrijfsfilms tot online campagnes. Hier een greep uit recent voice-over werk.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Corendon -->
        <div class="rounded-xl overflow-hidden" style="box-shadow: var(--shadow-card);">
          <div class="relative w-full" style="padding-bottom: 56.25%;">
            <iframe
              class="absolute inset-0 w-full h-full"
              src="https://www.youtube-nocookie.com/embed/iX3_I3ns1x8"
              title="Voice-over Corendon commercial"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="px-5 py-4" style="background-color: var(--bg);">
            <p class="font-medium">Corendon</p>
            <p class="text-sm" style="color: var(--fg-muted);">TV Commercial</p>
          </div>
        </div>

        <!-- Danerolles -->
        <div class="rounded-xl overflow-hidden" style="box-shadow: var(--shadow-card);">
          <div class="relative w-full" style="padding-bottom: 56.25%;">
            <iframe
              class="absolute inset-0 w-full h-full"
              src="https://www.youtube-nocookie.com/embed/te3sgGdAS5w"
              title="Voice-over Danerolles commercial"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="px-5 py-4" style="background-color: var(--bg);">
            <p class="font-medium">Danerolles</p>
            <p class="text-sm" style="color: var(--fg-muted);">TV Commercial</p>
          </div>
        </div>

        <!-- Smeerkees -->
        <div class="rounded-xl overflow-hidden" style="box-shadow: var(--shadow-card);">
          <div class="relative w-full" style="padding-bottom: 56.25%;">
            <iframe
              class="absolute inset-0 w-full h-full"
              src="https://www.youtube-nocookie.com/embed/hw-vY-XSpOg"
              title="Voice-over Smeerkees"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="px-5 py-4" style="background-color: var(--bg);">
            <p class="font-medium">Smeerkees</p>
            <p class="text-sm" style="color: var(--fg-muted);">Commercial</p>
          </div>
        </div>

        <!-- Locally Made -->
        <div class="rounded-xl overflow-hidden" style="box-shadow: var(--shadow-card);">
          <div class="relative w-full" style="padding-bottom: 56.25%;">
            <iframe
              class="absolute inset-0 w-full h-full"
              src="https://www.youtube-nocookie.com/embed/JL3BAPSzLVM"
              title="Voice-over Locally Made"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="px-5 py-4" style="background-color: var(--bg);">
            <p class="font-medium">Locally Made</p>
            <p class="text-sm" style="color: var(--fg-muted);">Online campagne</p>
          </div>
        </div>
      </div>

      <!-- Extra video -->
      <div class="mt-6 max-w-[calc(50%-0.75rem)] mx-auto hidden md:block">
        <div class="rounded-xl overflow-hidden" style="box-shadow: var(--shadow-card);">
          <div class="relative w-full" style="padding-bottom: 56.25%;">
            <iframe
              class="absolute inset-0 w-full h-full"
              src="https://www.youtube-nocookie.com/embed/CR6etJfaiq0"
              title="Voice-over voorbeeld"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="px-5 py-4" style="background-color: var(--bg);">
            <p class="font-medium">Commercial</p>
            <p class="text-sm" style="color: var(--fg-muted);">TV &amp; Online</p>
          </div>
        </div>
      </div>
      <!-- Mobile: 5th video shown inline -->
      <div class="mt-6 md:hidden">
        <div class="rounded-xl overflow-hidden" style="box-shadow: var(--shadow-card);">
          <div class="relative w-full" style="padding-bottom: 56.25%;">
            <iframe
              class="absolute inset-0 w-full h-full"
              src="https://www.youtube-nocookie.com/embed/CR6etJfaiq0"
              title="Voice-over voorbeeld"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="px-5 py-4" style="background-color: var(--bg);">
            <p class="font-medium">Commercial</p>
            <p class="text-sm" style="color: var(--fg-muted);">TV &amp; Online</p>
          </div>
        </div>
      </div>
      <!-- CTA na portfolio -->
      <div class="mt-12 text-center">
        <a
          href="#boeken"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full text-lg font-semibold text-white transition-all duration-300 hover:scale-[1.03]"
          style="background-color: var(--color-gold);"
        >
          Klinkt goed? Boek direct
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================
       TESTIMONIALS
       ============================================ -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-[var(--font-display)] text-4xl">Wat klanten zeggen</h2>
        <div class="mt-4 h-1 w-12 rounded-full mx-auto" style="background: linear-gradient(90deg, var(--color-gold-dark), var(--color-gold), var(--color-gold-light));"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <!-- Danerolles (gecombineerd) -->
        <div class="rounded-2xl p-8" style="background-color: var(--bg-surface); box-shadow: var(--shadow-card);">
          <div class="flex items-center gap-1 mb-4">
