  <!-- ============================================
       BOOKING FORM
       ============================================ -->
  <section id="boeken" class="py-20 md:py-28">
    <div class="mx-auto max-w-[700px] px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-[var(--font-display)] text-4xl">Voice-over boeken</h2>
        <div class="mt-4 h-1 w-12 rounded-full mx-auto" style="background: linear-gradient(90deg, var(--color-gold-dark), var(--color-gold), var(--color-gold-light));"></div>
        <p class="mt-4 text-lg" style="color: var(--fg-muted);">
          Voice-over inhuren? Stuur je briefing en ik reageer binnen 2 uur op werkdagen met een offerte op maat.
        </p>
      </div>

      <div
        class="p-6 lg:p-8 rounded-2xl"
        style="background-color: var(--bg-surface); box-shadow: var(--shadow-card);"
      >
        <form id="vo-form" class="space-y-5" action="https://formspree.io/f/mzdabblp" method="POST">
          <!-- Hidden field om VO aanvragen te onderscheiden -->
          <input type="hidden" name="_subject" value="Voice-over aanvraag via website" />
          <input type="hidden" name="type" value="voiceover" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="vo-name" class="block text-sm font-medium mb-1">Naam *</label>
              <input
                type="text"
                id="vo-name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-lg border border-[var(--bg-surface)] text-base transition-colors duration-300 focus:border-[var(--color-gold)] focus:outline-none"
                style="background-color: var(--bg); color: var(--fg);"
              />
            </div>
            <div>
              <label for="vo-company" class="block text-sm font-medium mb-1">Bedrijf</label>
              <input
                type="text"
                id="vo-company"
                name="company"
                class="w-full px-4 py-3 rounded-lg border border-[var(--bg-surface)] text-base transition-colors duration-300 focus:border-[var(--color-gold)] focus:outline-none"
                style="background-color: var(--bg); color: var(--fg);"
              />
            </div>
          </div>

          <div>
            <label for="vo-email" class="block text-sm font-medium mb-1">E-mail *</label>
            <input
              type="email"
              id="vo-email"
              name="email"
              required
              class="w-full px-4 py-3 rounded-lg border border-[var(--bg-surface)] text-base transition-colors duration-300 focus:border-[var(--color-gold)] focus:outline-none"
              style="background-color: var(--bg); color: var(--fg);"
            />
          </div>

          <div>
            <label for="vo-project" class="block text-sm font-medium mb-1">Type project *</label>
            <select
              id="vo-project"
              name="project_type"
              required
              class="w-full px-4 py-3 rounded-lg border border-[var(--bg-surface)] text-base transition-colors duration-300 focus:border-[var(--color-gold)] focus:outline-none"
              style="background-color: var(--bg); color: var(--fg);"
            >
              <option value="">Kies een type...</option>
              <option value="commercial">Commercial (TV / radio / online)</option>
              <option value="bedrijfsfilm">Bedrijfsfilm / corporate video</option>
              <option value="elearning">E-learning / instructievideo</option>
              <option value="luisterboek">Luisterboek / audioboek</option>
              <option value="stemacteur">Stemacteur / karakter</option>
              <option value="anders">Anders</option>
            </select>
          </div>

          <div>
            <label for="vo-message" class="block text-sm font-medium mb-1">Briefing / omschrijving *</label>
            <textarea
              id="vo-message"
              name="message"
              rows="5"
              required
              placeholder="Vertel kort over je project, gewenste stijl en deadline..."
              class="w-full px-4 py-3 rounded-lg border border-[var(--bg-surface)] text-base transition-colors duration-300 focus:border-[var(--color-gold)] focus:outline-none resize-y"
              style="background-color: var(--bg); color: var(--fg);"
            ></textarea>
          </div>

          <div>
            <label for="vo-script" class="block text-sm font-medium mb-1">Script bijvoegen</label>
            <label
              for="vo-script"
              class="flex items-center gap-3 w-full px-4 py-3 rounded-lg border border-dashed border-[var(--fg-muted)]/30 cursor-pointer transition-colors duration-300 hover:border-[var(--color-gold)]"
              style="background-color: var(--bg);"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" style="color: var(--fg-muted);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.112 2.13" />
              </svg>
              <span id="vo-script-label" class="text-sm truncate" style="color: var(--fg-muted);">PDF, Word of tekstbestand (max 10 MB)</span>
            </label>
            <input
              type="file"
              id="vo-script"
              name="script"
              accept=".pdf,.doc,.docx,.txt,.rtf"
              class="sr-only"
            />
          </div>

          <button
            type="submit"
            class="w-full sm:w-auto px-8 py-3 rounded-full font-medium text-base text-white transition-all duration-300 bg-[var(--color-gold)] hover:bg-[var(--color-gold-light)] active:bg-[var(--color-gold-dark)] active:scale-[0.97] disabled:opacity-50 disabled:cursor-not-allowed btn-primary"
          >
            Verstuur aanvraag
          </button>
          <p id="vo-message-status" class="text-sm min-h-[1.25rem]" aria-live="polite"></p>
        </form>
      </div>

      <!-- Direct contact fallback -->
      <p class="text-center mt-6 text-base" style="color: var(--fg-muted);">
        Liever direct mailen?
        <a
          href="mailto:ed@earswantmusic.nl?subject=Voice-over%20aanvraag"
          class="font-medium transition-colors duration-300"
          style="color: var(--color-gold);"
        >
          ed@earswantmusic.nl
        </a>
      </p>
    </div>
  </section>

</BaseLayout>

<script>
  function initHeroVideo() {
    const video = document.getElementById('hero-video') as HTMLVideoElement;
    const btn = document.getElementById('hero-unmute');
    const iconMuted = document.getElementById('icon-muted');
    const iconUnmuted = document.getElementById('icon-unmuted');
    const label = document.getElementById('mute-label');
    if (!video || !btn) return;

    btn.addEventListener('click', () => {
      video.muted = !video.muted;
      if (video.muted) {
        iconMuted!.classList.remove('hidden');
        iconUnmuted!.classList.add('hidden');
        label!.textContent = 'Geluid aan';
      } else {
        iconMuted!.classList.add('hidden');
        iconUnmuted!.classList.remove('hidden');
        label!.textContent = 'Geluid uit';
      }
    });
  }

  initHeroVideo();
  document.addEventListener('astro:after-swap', initHeroVideo);

  function initVoForm() {
    const form = document.getElementById('vo-form') as HTMLFormElement;
    if (!form || form.dataset.init) return;
    form.dataset.init = '1';

    const messageEl = document.getElementById('vo-message-status')!;
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

    const scriptInput = document.getElementById('vo-script') as HTMLInputElement;
    const scriptLabel = document.getElementById('vo-script-label')!;
    const defaultLabel = 'PDF, Word of tekstbestand (max 10 MB)';

    scriptInput.addEventListener('change', () => {
      if (scriptInput.files?.length) {
        const file = scriptInput.files[0];
        if (file.size > 10 * 1024 * 1024) {
          scriptLabel.textContent = 'Bestand te groot (max 10 MB)';
          scriptLabel.style.color = 'var(--color-red, #ef4444)';
          scriptInput.value = '';
          return;
        }
        scriptLabel.textContent = file.name;
        scriptLabel.style.color = 'var(--fg)';
      } else {
        scriptLabel.textContent = defaultLabel;
        scriptLabel.style.color = 'var(--fg-muted)';
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const originalText = submitBtn.textContent;
      submitBtn.textContent = 'Bezig met versturen...';
      submitBtn.disabled = true;
      messageEl.textContent = '';
      messageEl.className = 'text-sm min-h-[1.25rem]';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'Accept': 'application/json' },
        });

        if (response.ok) {
          messageEl.textContent = 'Bedankt! Je aanvraag is ontvangen. Ik reageer binnen 2 uur op werkdagen.';
          messageEl.classList.add('text-[var(--color-gold)]');
          form.reset();
          scriptLabel.textContent = defaultLabel;
          scriptLabel.style.color = 'var(--fg-muted)';
        } else {
          messageEl.textContent = 'Er ging iets mis. Probeer het opnieuw of mail direct naar ed@earswantmusic.nl.';
          messageEl.classList.add('text-red-500');
        }
      } catch {
        messageEl.textContent = 'Geen verbinding. Mail naar ed@earswantmusic.nl.';
        messageEl.classList.add('text-red-500');
      } finally {
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      }
    });
  }

  initVoForm();
  document.addEventListener('astro:after-swap', initVoForm);
</script>

