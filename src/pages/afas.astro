---
export const prerender = true;

const pageTitle = "Cadeau voor AFAS Live bezoekers — Ed Struijlaart";
const pageDescription = "Was je in de AFAS Live bij Gypsy Kings? Laat je mailadres achter en ontvang morgen een exclusief cadeau van Ed Struijlaart.";
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href="https://edstruijlaart.nl/afas" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://edstruijlaart.nl/afas" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content="nl_NL" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;700;800;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg: #E9E9E6;
        --text: #1A1A1A;
        --text-muted: #666666;
        --accent: #00AACC;
        --accent-dark: #0092B0;
        --white: #FFFFFF;
        --border: rgba(0,0,0,0.10);
        --font-display: 'Barlow Condensed', 'Arial Narrow', Arial, sans-serif;
        --font-body: 'Inter', system-ui, sans-serif;
      }

      html { scroll-behavior: smooth; }
      body {
        font-family: var(--font-body);
        background-color: var(--bg);
        color: var(--text);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        min-height: 100svh;
      }
      img { display: block; max-width: 100%; }
      a { color: inherit; text-decoration: none; }
      button { cursor: pointer; font-family: inherit; border: none; background: none; }

      .grain {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        opacity: 0.05;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
        background-repeat: repeat;
        background-size: 180px 180px;
      }

      /* ─── LAYOUT ─── */
      .page {
        min-height: 100svh;
        display: grid;
        grid-template-columns: 1fr 1fr;
        position: relative;
        overflow: hidden;
      }

      .photo {
        position: relative;
        background: #1a1a1a;
        overflow: hidden;
      }
      .photo img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(100%) contrast(1.05);
      }
      .photo::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 60%, rgba(0,0,0,0.4) 100%);
        pointer-events: none;
      }

      .content {
        padding: clamp(2rem, 5vw, 4.5rem);
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        z-index: 2;
        max-width: 640px;
      }

      .eyebrow {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin-bottom: 1.5rem;
      }
      .eyebrow-line { width: 2rem; height: 2px; background: var(--accent); flex-shrink: 0; }
      .eyebrow-text {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 0.95rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      h1 {
        font-family: var(--font-display);
        font-weight: 900;
        font-size: clamp(2.6rem, 5.5vw, 4.5rem);
        line-height: 0.95;
        letter-spacing: -0.01em;
        text-transform: uppercase;
        margin-bottom: 1.5rem;
      }
      h1 .accent { color: var(--accent); display: block; }

      .lead {
        font-size: clamp(1.05rem, 1.5vw, 1.2rem);
        line-height: 1.55;
        color: var(--text);
        margin-bottom: 2.5rem;
        max-width: 460px;
      }

      /* ─── FORM ─── */
      form { display: flex; flex-direction: column; gap: 0.85rem; max-width: 440px; }
      .field {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }
      .field label {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-muted);
      }
      .field input {
        font-family: var(--font-body);
        font-size: 1.05rem;
        padding: 0.95rem 1.1rem;
        border: 1.5px solid var(--border);
        border-radius: 4px;
        background: var(--white);
        color: var(--text);
        transition: border-color 0.15s, box-shadow 0.15s;
      }
      .field input:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(0,170,204,0.18);
      }

      button[type="submit"] {
        margin-top: 0.5rem;
        background: var(--accent);
        color: var(--white);
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 1.1rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 1rem 1.4rem;
        border-radius: 4px;
        transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
        box-shadow: 0 2px 10px rgba(0, 170, 204, 0.3);
      }
      button[type="submit"]:hover:not(:disabled) {
        background: var(--accent-dark);
        transform: translateY(-1px);
        box-shadow: 0 4px 16px rgba(0, 170, 204, 0.4);
      }
      button[type="submit"]:disabled { opacity: 0.6; cursor: wait; }

      .privacy {
        margin-top: 1rem;
        font-size: 0.85rem;
        color: var(--text-muted);
        line-height: 1.5;
      }

      .error {
        margin-top: 0.75rem;
        color: #b00020;
        font-size: 0.9rem;
        display: none;
      }
      .error.show { display: block; }

      /* ─── SUCCESS STATE ─── */
      .success {
        display: none;
        flex-direction: column;
        gap: 1.25rem;
        max-width: 460px;
      }
      .success.show { display: flex; }
      form.hide { display: none; }
      .lead.hide, .eyebrow.hide, h1.hide { display: none; }

      .success-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--accent);
        color: var(--white);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
      }
      .success h2 {
        font-family: var(--font-display);
        font-weight: 900;
        font-size: clamp(2rem, 4vw, 3rem);
        text-transform: uppercase;
        line-height: 1;
      }
      .success p { font-size: 1.05rem; line-height: 1.6; }
      .success p strong { color: var(--accent); }

      /* ─── FOOTER ─── */
      .footer {
        position: absolute;
        bottom: 1.5rem;
        left: clamp(2rem, 5vw, 4.5rem);
        font-size: 0.8rem;
        color: var(--text-muted);
        letter-spacing: 0.04em;
      }
      .footer a { color: var(--text-muted); border-bottom: 1px solid currentColor; }

      /* ─── MOBILE ─── */
      @media (max-width: 820px) {
        .page { grid-template-columns: 1fr; grid-template-rows: 38vh 1fr; }
        .photo img { object-position: center 25%; }
        .content { padding: 2rem 1.5rem 5rem; }
        .footer { position: static; margin-top: 2rem; padding-left: 0; }
      }
    </style>
  </head>

  <body>
    <main class="page">
      <div class="photo">
        <img src="/images/afas/ed-portrait.jpg" alt="Ed Struijlaart" loading="eager" />
      </div>

      <section class="content">
        <div class="grain"></div>

        <div class="eyebrow" id="eyebrow">
          <span class="eyebrow-line"></span>
          <span class="eyebrow-text">Cadeau voor AFAS Live bezoekers</span>
        </div>

        <h1 id="title">
          Bedankt
          <span class="accent">voor het scannen</span>
        </h1>

        <p class="lead" id="lead">
          Laat hieronder je e-mailadres achter. Je krijgt direct een bevestiging in je inbox, en morgen stuur ik je een exclusieve gratis download.
        </p>

        <form id="signup-form">
          <div class="field">
            <label for="name">Voornaam <span style="text-transform:none;color:#999;font-weight:400;">(optioneel)</span></label>
            <input type="text" id="name" name="name" autocomplete="given-name" placeholder="Hoe heet je?" />
          </div>
          <div class="field">
            <label for="email">E-mailadres</label>
            <input type="email" id="email" name="email" autocomplete="email" required placeholder="jij@voorbeeld.nl" />
          </div>
          <button type="submit" id="submit-btn">Stuur me mijn cadeau</button>
          <p class="privacy">Geen spam, alleen wat moois van mij. Uitschrijven kan altijd.</p>
          <p class="error" id="error-msg"></p>
        </form>

        <div class="success" id="success">
          <div class="success-icon">✓</div>
          <h2>Check je mail</h2>
          <p>
            Je krijgt zo een bevestiging in je inbox. <strong>Morgen</strong> stuur ik je de exclusieve download.
          </p>
          <p style="font-size:0.95rem;color:var(--text-muted);">
            Niets ontvangen? Check je spam-folder, of mail <a href="mailto:ed@earswantmusic.nl" style="color:var(--accent);">ed@earswantmusic.nl</a>.
          </p>
        </div>

        <div class="footer">
          <a href="https://gitaarmannen.nl/continuum">Gitaarmannen 4: Continuum →</a>
        </div>
      </section>
    </main>

    <script is:inline>
      (() => {
        const form = document.getElementById('signup-form');
        const success = document.getElementById('success');
        const btn = document.getElementById('submit-btn');
        const errEl = document.getElementById('error-msg');
        const lead = document.getElementById('lead');
        const eyebrow = document.getElementById('eyebrow');
        const title = document.getElementById('title');

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          errEl.classList.remove('show');
          btn.disabled = true;
          btn.textContent = 'Bezig...';

          const data = new FormData(form);
          try {
            const res = await fetch('/api/subscribe-afas', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                email: data.get('email'),
                name: data.get('name'),
              }),
            });
            const json = await res.json().catch(() => ({}));
            if (res.ok && json.success) {
              form.classList.add('hide');
              lead.classList.add('hide');
              eyebrow.classList.add('hide');
              title.classList.add('hide');
              success.classList.add('show');
              window.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
              errEl.textContent = json.error || 'Er ging iets mis, probeer het opnieuw.';
              errEl.classList.add('show');
              btn.disabled = false;
              btn.textContent = 'Stuur me mijn cadeau';
            }
          } catch {
            errEl.textContent = 'Geen verbinding. Probeer het opnieuw.';
            errEl.classList.add('show');
            btn.disabled = false;
            btn.textContent = 'Stuur me mijn cadeau';
          }
        });
      })();
    </script>
  </body>
</html>
