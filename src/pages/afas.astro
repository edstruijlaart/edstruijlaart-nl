---
export const prerender = true;

import { AFAS_KIJK_URL, AFAS_VIDEO_ID } from "../data/afas-funnel";

// AFAS Live cadeau-funnel -> GM4 Continuum.
// URL: edstruijlaart.nl/afas (aangejaagd door een reel).
// Vangt naam + e-mail + woonplaats -> /api/subscribe-afas (woonplaats -> provincie,
// Listmonk-funnel + provincie-lijst, bedankmail). Daarna staat het hele concert
// direct op de pagina. Stijl bewust gelijk aan /continuum (Barlow Condensed, #00AACC).
// Alle CSS is gescoped onder .afas: bare :root/html/body/* lekken in Astro
// site-breed, dus die vermijden we hier (page-achtergrond staat inline op <body>).

const FUNNEL_ENDPOINT = "/api/subscribe-afas";

const pageTitle = "Gratis: mijn hele AFAS Live concert · Ed Struijlaart";
const pageDescription =
  "Ik speelde in het voorprogramma van de Gipsy Kings in de AFAS Live. Die hele set geef ik je cadeau. Laat je gegevens achter en kijk meteen.";
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href="https://edstruijlaart.nl/afas" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://edstruijlaart.nl/afas" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="https://edstruijlaart.nl/images/afas/ed-hero.jpg" />
    <meta property="og:locale" content="nl_NL" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;700;800;900&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Analytics (Umami, cookieless) -->
    <script defer src="https://analytics.earswantmusic.nl/script.js" data-website-id="98cc05e1-4825-4c78-a94a-e823227f0cc3"></script>

    <!-- Ad-pixel framework (Meta / TikTok / Google). Leeg = laadt niet, geen tracking.
         Vul de ID's in om te activeren, zonder rebuild van de logica. -->
    <script is:inline>
      window.AFAS_ADS = {
        metaPixelId: "1675651260382047",   /* zelfde dataset als GM3 ("gitaarmannen funnel") */
        tiktokPixelId: "",                  /* geen TikTok-account */
        googleAdsId: "AW-11309058298",      /* zelfde Google Ads-account als GM3 */
        googleConversionLabel: "TVjtCI7vkMAcEPqRypAq"  /* conversie-actie "Aanmelding" */
      };
      (function () {
        var A = window.AFAS_ADS;
        if (A.metaPixelId) {
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', A.metaPixelId); fbq('track', 'PageView');
        }
        if (A.googleAdsId) {
          var g=document.createElement('script');g.async=true;g.src='https://www.googletagmanager.com/gtag/js?id='+A.googleAdsId;document.head.appendChild(g);
          window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments);};gtag('js',new Date());gtag('config',A.googleAdsId);
        }
      })();
    </script>

    <style>
      .afas, .afas *, .afas *::before, .afas *::after {
        box-sizing: border-box; margin: 0; padding: 0;
      }
      .afas {
        --bg-dark: #161614;
        --bg-darker: #0e0e0d;
        --muted: rgba(255,255,255,0.72);
        --faint: rgba(255,255,255,0.5);
        --accent: #00aacc;
        --accent-dark: #0092b0;
        --white: #ffffff;
        --font-display: "Barlow Condensed", "Arial Narrow", Arial, sans-serif;
        --font-body: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
        font-family: var(--font-body);
        background-color: var(--bg-dark);
        color: var(--white);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        min-height: 100svh;
      }
      .afas a { color: inherit; text-decoration: none; }
      .afas button { cursor: pointer; font-family: inherit; border: none; background: none; }
      .afas img { display: block; max-width: 100%; }

      .afas .container { width: 100%; max-width: 1080px; margin: 0 auto; padding: 0 1.5rem; }

      .afas .section-label {
        font-family: var(--font-display); text-transform: uppercase;
        letter-spacing: 0.18em; font-size: 0.8rem; font-weight: 700;
        color: var(--accent); margin-bottom: 1rem;
      }

      /* Topbar */
      .afas .topbar {
        position: sticky; top: 0; z-index: 50;
        background: rgba(14,14,13,0.85); backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255,255,255,0.08);
      }
      .afas .topbar-inner {
        display: flex; align-items: center; justify-content: space-between; height: 60px;
      }
      .afas .topbar-badge {
        font-family: var(--font-display); font-weight: 800;
        text-transform: uppercase; letter-spacing: 0.06em; font-size: 1.05rem;
      }
      .afas .topbar-cta {
        font-family: var(--font-display); font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.85rem;
        color: var(--accent);
      }

      /* Hero */
      .afas .hero {
        position: relative;
        background:
          radial-gradient(circle at 72% 20%, rgba(0,170,204,0.18), transparent 55%),
          var(--bg-darker);
        padding: clamp(2.5rem, 7vw, 5.5rem) 0 clamp(2.5rem, 6vw, 4rem);
        overflow: hidden;
      }
      .afas .hero-grid {
        display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items: center;
      }
      .afas .hero-eyebrow {
        font-family: var(--font-display); text-transform: uppercase;
        letter-spacing: 0.16em; font-weight: 700; font-size: 0.9rem;
        color: var(--accent); margin-bottom: 1.1rem;
      }
      .afas .hero-title {
        font-family: var(--font-display); font-weight: 900;
        font-size: clamp(2.6rem, 6vw, 4.6rem); line-height: 0.95;
        text-transform: uppercase; letter-spacing: -0.01em; margin-bottom: 1.4rem;
      }
      .afas .hero-title .accent { color: var(--accent); }
      .afas .hero-sub { font-size: 1.15rem; color: var(--muted); max-width: 46ch; margin-bottom: 2rem; }
      .afas .hero-photo {
        border-radius: 8px; overflow: hidden;
        box-shadow: 0 30px 60px rgba(0,0,0,0.5);
        aspect-ratio: 4 / 5; background: #222;
      }
      .afas .hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; }

      .afas .btn-primary {
        display: inline-flex; align-items: center; gap: 0.6rem;
        background: var(--accent); color: var(--white);
        font-family: var(--font-display); font-weight: 800;
        text-transform: uppercase; letter-spacing: 0.05em; font-size: 1.05rem;
        padding: 1rem 2rem; border-radius: 4px;
        transition: background 0.2s, transform 0.2s;
      }
      .afas .btn-primary:hover { background: var(--accent-dark); transform: translateY(-2px); }

      /* Intro / kennismaking */
      .afas .intro { padding: clamp(3rem, 7vw, 5rem) 0; background: var(--bg-dark); }
      .afas .intro-grid {
        display: grid; grid-template-columns: 1fr 0.85fr; gap: 3rem; align-items: center;
      }
      .afas .intro-lead {
        font-size: 1.15rem; color: rgba(255,255,255,0.85); margin-bottom: 1.25rem;
      }
      .afas .intro-lead strong { color: var(--white); }
      .afas .intro p { color: var(--muted); margin-bottom: 1rem; }
      .afas .highlights { list-style: none; display: grid; gap: 0.7rem; margin-top: 1.5rem; }
      .afas .highlights li {
        display: flex; gap: 0.75rem; align-items: flex-start;
        font-size: 0.98rem; color: rgba(255,255,255,0.82);
      }
      .afas .highlights .tick { color: var(--accent); font-weight: 800; flex-shrink: 0; }
      .afas .intro-photo { border-radius: 8px; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.45); }
      .afas .intro-photo img { width: 100%; height: 100%; object-fit: cover; }

      /* Value */
      .afas .value {
        padding: clamp(3rem, 7vw, 5rem) 0;
        background: var(--bg-darker); border-top: 1px solid rgba(255,255,255,0.06);
      }
      .afas .value-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.5rem; margin-top: 2rem;
      }
      .afas .value-card {
        background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
        border-radius: 8px; padding: 1.5rem;
      }
      .afas .value-card h3 {
        font-family: var(--font-display); font-weight: 700; font-size: 1.3rem;
        text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 0.5rem; color: var(--accent);
      }
      .afas .value-card p { color: var(--muted); font-size: 0.95rem; }

      /* Signup */
      .afas .signup {
        padding: clamp(3rem, 7vw, 5rem) 0;
        background:
          radial-gradient(circle at 30% 0%, rgba(0,170,204,0.14), transparent 50%),
          var(--bg-dark);
        border-top: 1px solid rgba(255,255,255,0.06);
      }
      .afas .signup-inner { max-width: 560px; margin: 0 auto; text-align: center; }
      .afas .signup h2 {
        font-family: var(--font-display); font-weight: 900;
        font-size: clamp(2rem, 5vw, 3rem); text-transform: uppercase;
        line-height: 1; margin-bottom: 0.75rem;
      }
      .afas .signup-sub { color: var(--muted); margin-bottom: 2rem; }

      .afas .signup-form { display: flex; flex-direction: column; gap: 0.85rem; text-align: left; }
      .afas .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; }
      .afas .form-input {
        width: 100%; padding: 0.95rem 1rem;
        background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.16);
        border-radius: 4px; color: var(--white); font-size: 1rem;
        font-family: var(--font-body); transition: border-color 0.2s;
      }
      .afas .form-input::placeholder { color: rgba(255,255,255,0.4); }
      .afas .form-input:focus { outline: none; border-color: var(--accent); }

      .afas .btn-submit {
        width: 100%; background: var(--accent); color: var(--white);
        font-family: var(--font-display); font-weight: 800;
        text-transform: uppercase; letter-spacing: 0.05em; font-size: 1.1rem;
        padding: 1.05rem; border-radius: 4px; margin-top: 0.25rem; transition: background 0.2s;
      }
      .afas .btn-submit:hover { background: var(--accent-dark); }
      .afas .btn-submit:disabled { opacity: 0.6; cursor: wait; }

      .afas .form-microcopy { font-size: 0.82rem; color: var(--faint); margin-top: 0.4rem; }
      .afas .form-microcopy.why { color: rgba(255,255,255,0.62); margin-top: -0.3rem; }
      .afas .form-error { display: none; color: #ff9b9b; font-size: 0.9rem; margin-top: 0.5rem; }

      /* Success + video */
      .afas .form-success { display: none; flex-direction: column; align-items: center; gap: 1.1rem; text-align: center; }
      .afas .form-success.show { display: flex; }
      .afas .signup-form.hide { display: none; }
      .afas .form-success-icon {
        width: 56px; height: 56px; border-radius: 50%; background: var(--accent);
        display: flex; align-items: center; justify-content: center;
      }
      .afas .form-success strong {
        color: var(--white); font-size: 1.6rem; font-family: var(--font-display);
        text-transform: uppercase; letter-spacing: 0.04em;
      }
      .afas .form-success p { color: var(--muted); }
      .afas .video-wrap {
        position: relative; width: 100%; aspect-ratio: 16 / 9;
        border-radius: 8px; overflow: hidden; background: #000;
        box-shadow: 0 24px 50px rgba(0,0,0,0.55); margin: 0.5rem 0;
      }
      .afas .video-wrap iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

      /* Footer */
      .afas .footer { padding: 2.5rem 0; background: var(--bg-darker); text-align: center; border-top: 1px solid rgba(255,255,255,0.06); }
      .afas .footer a { color: var(--accent); font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.05em; }
      .afas .footer p { color: var(--faint); font-size: 0.85rem; margin-top: 0.5rem; }

      @media (max-width: 820px) {
        .afas .hero-grid { grid-template-columns: 1fr; }
        .afas .hero-photo { max-width: 340px; margin: 0 auto; order: -1; }
        .afas .intro-grid { grid-template-columns: 1fr; }
        .afas .intro-photo { max-width: 460px; margin: 0 auto; }
        .afas .form-row { grid-template-columns: 1fr; }
      }
    </style>
  </head>

  <body style="margin:0; background:#0e0e0d;">
    <main class="afas">
      <!-- TOPBAR -->
      <header class="topbar">
        <div class="container">
          <div class="topbar-inner">
            <span class="topbar-badge">Ed Struijlaart</span>
            <a href="#aanmelden" class="topbar-cta">Bekijk het concert</a>
          </div>
        </div>
      </header>

      <!-- HERO -->
      <section class="hero">
        <div class="container">
          <div class="hero-grid">
            <div>
              <p class="hero-eyebrow">Voorprogramma Gipsy Kings · AFAS Live</p>
              <h1 class="hero-title">
                Mijn hele concert.<br /><span class="accent">Gratis</span>, bij jou op de bank.
              </h1>
              <p class="hero-sub">
                Ik speelde in het voorprogramma van de Gipsy Kings in de AFAS Live.
                Die hele set heb ik opgenomen, en die geef ik je cadeau.
                Laat je gegevens achter en kijk meteen.
              </p>
              <a href="#aanmelden" class="btn-primary" data-umami-event="afas-hero-cta">Stuur mij het concert</a>
            </div>
            <div class="hero-photo">
              <picture>
                <source srcset="/images/afas/ed-hero.webp" type="image/webp" />
                <img src="/images/afas/ed-hero.jpg" alt="Ed Struijlaart live met gitaar" loading="eager" />
              </picture>
            </div>
          </div>
        </div>
      </section>

      <!-- EVEN VOORSTELLEN -->
      <section class="intro">
        <div class="container">
          <div class="intro-grid">
            <div>
              <p class="section-label">Even voorstellen</p>
              <p class="intro-lead">
                Ik ben <strong>Ed Struijlaart</strong>, singer-songwriter, en ik speel al een
                leven lang gitaar. Misschien ken je me ergens van, misschien ook niet. Dit ben ik:
              </p>
              <ul class="highlights">
                <li><span class="tick">▸</span><span>Mijn single <strong>Make It On Your Own</strong> ging platina.</span></li>
                <li><span class="tick">▸</span><span>Eigen albums: <strong>Closer Than Skin</strong> en <strong>Head Heart &amp; Hands</strong>.</span></li>
                <li><span class="tick">▸</span><span>Met de theatershow <strong>Gitaarmannen</strong> sta ik door het hele land, in zo'n 25 theaters.</span></li>
                <li><span class="tick">▸</span><span>De <strong>Gitaarmannen-podcast</strong> heeft een kleine 20.000 abonnees op YouTube.</span></li>
                <li><span class="tick">▸</span><span>Oud-dj bij <strong>Radio Veronica</strong>.</span></li>
                <li><span class="tick">▸</span><span>Laatst te gast bij <strong>Jan-Willem Ruimt Op</strong> op NPO 1, met All Along the Watchtower.</span></li>
              </ul>
            </div>
            <div class="intro-photo">
              <picture>
                <source srcset="/images/afas/ed-wide.webp" type="image/webp" />
                <img src="/images/afas/ed-wide.jpg" alt="Ed Struijlaart" loading="lazy" />
              </picture>
            </div>
          </div>
        </div>
      </section>

      <!-- WAT JE KRIJGT -->
      <section class="value">
        <div class="container">
          <p class="section-label">Wat je krijgt</p>
          <div class="value-grid">
            <div class="value-card">
              <h3>Het hele concert</h3>
              <p>Geen los fragment. De complete set die ik speelde in de AFAS Live, van begin tot eind.</p>
            </div>
            <div class="value-card">
              <h3>Van Ain't No Sunshine tot Gravity</h3>
              <p>Akoestisch, puur, zoals het in de zaal klonk. Inclusief twee nummers van John Mayers Continuum.</p>
            </div>
            <div class="value-card">
              <h3>Direct kijken</h3>
              <p>Je krijgt het concert meteen op je scherm. Geen gedoe, gewoon op play.</p>
            </div>
            <div class="value-card">
              <h3>En de mp3's erbij</h3>
              <p>In de mail vind je ook alle nummers om te downloaden. Voor onderweg.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- AANMELDEN -->
      <section class="signup" id="aanmelden">
        <div class="container">
          <div class="signup-inner">
            <h2>Waar mag ik het naartoe sturen?</h2>
            <p class="signup-sub">Vul je gegevens in en het hele concert staat meteen voor je klaar.</p>

            <form class="signup-form" id="signup-form">
              <div class="form-row">
                <input class="form-input" type="text" name="name" placeholder="Je voornaam" required autocomplete="given-name" />
                <input class="form-input" type="email" name="email" placeholder="naam@email.nl" required autocomplete="email" />
              </div>
              <input class="form-input" type="text" name="woonplaats" placeholder="Je woonplaats" required autocomplete="address-level2" />
              <p class="form-microcopy why">
                In welke plaats woon je? Dan laat ik je weten wanneer ik bij jou in de buurt speel.
              </p>
              <button type="submit" class="btn-submit">Stuur mij het concert</button>
              <p class="form-microcopy">
                Ik gebruik je e-mailadres alleen om je het concert te sturen en je af en toe iets te laten weten. Geen spam, uitschrijven kan altijd met een klik.
              </p>
              <p class="form-error" id="form-error"></p>
            </form>

            <!-- SUCCESS + VIDEO -->
            <div class="form-success" id="form-success">
              <div class="form-success-icon">
                <svg width="28" height="28" fill="none" stroke="white" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </div>
              <strong>Veel kijkplezier</strong>
              <p>Hieronder staat het hele concert. Ik heb je ook een mail gestuurd met de link, de mp3's en mijn theaterdata. Check eventueel je spam.</p>
              <div class="video-wrap">
                <iframe id="afas-video" title="Ed Struijlaart live in de AFAS Live" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
              </div>
              <a class="btn-primary" href="https://gitaarmannen.nl/continuum" target="_blank" rel="noopener" data-umami-event="afas-naar-continuum">Dit najaar live: Gitaarmannen 4 Continuum</a>
            </div>
          </div>
        </div>
      </section>

      <footer class="footer">
        <div class="container">
          <a href="https://www.edstruijlaart.nl">edstruijlaart.nl</a>
          <p>Ed Struijlaart · Ears Want Music</p>
        </div>
      </footer>
    </main>

    <script define:vars={{ endpoint: FUNNEL_ENDPOINT, videoId: AFAS_VIDEO_ID, watchUrl: AFAS_KIJK_URL }}>
      const form = document.getElementById("signup-form");
      const success = document.getElementById("form-success");
      const errorEl = document.getElementById("form-error");
      const iframe = document.getElementById("afas-video");
      const STORAGE_KEY = "afas_funnel_done";

      function toonSuccess() {
        if (iframe && !iframe.src) {
          iframe.src = "https://www.youtube.com/embed/" + videoId + "?rel=0&modestbranding=1";
        }
        if (form) form.classList.add("hide");
        if (success) success.classList.add("show");
      }

      // Refresh-fix: wie zich eerder aanmeldde ziet meteen het concert terug.
      if (localStorage.getItem(STORAGE_KEY)) toonSuccess();

      function toonFout(msg) {
        if (!errorEl) return;
        errorEl.textContent = msg;
        errorEl.style.display = "block";
      }

      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (errorEl) errorEl.style.display = "none";
        const btn = form.querySelector('button[type="submit"]');
        const originalText = btn.textContent;
        btn.textContent = "Bezig...";
        btn.disabled = true;

        const payload = {
          name: form.querySelector("[name=name]").value.trim(),
          email: form.querySelector("[name=email]").value.trim(),
          woonplaats: form.querySelector("[name=woonplaats]").value.trim(),
        };

        try {
          const res = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          if (res.ok) {
            const data = await res.json().catch(() => ({}));
            localStorage.setItem(STORAGE_KEY, "1");
            try { if (window.umami) umami.track("afas-aanmelding", { provincie: data.provincie || "onbekend" }); } catch (err) {}
            try { if (window.fbq) fbq("track", "CompleteRegistration", { content_name: "AFAS funnel" }); } catch (err) {}
            try { if (window.gtag && window.AFAS_ADS && AFAS_ADS.googleAdsId && AFAS_ADS.googleConversionLabel) gtag("event", "conversion", { send_to: AFAS_ADS.googleAdsId + "/" + AFAS_ADS.googleConversionLabel }); } catch (err) {}
            toonSuccess();
            success.scrollIntoView({ behavior: "smooth", block: "start" });
          } else {
            const data = await res.json().catch(() => ({}));
            toonFout(data.error || "Er ging iets mis. Probeer het zo nog eens.");
            btn.textContent = originalText;
            btn.disabled = false;
          }
        } catch {
          // Endpoint onbereikbaar: geef het concert toch, maar onthoud niets zodat
          // een nieuwe poging de mail alsnog kan sturen.
          toonSuccess();
          success.scrollIntoView({ behavior: "smooth", block: "start" });
          toonFout("De aanmelding haperde, maar je kunt het concert alvast bekijken. Probeer je aanmelding zo nog eens voor de mail.");
          btn.textContent = originalText;
          btn.disabled = false;
        }
      });
    </script>
  </body>
</html>
