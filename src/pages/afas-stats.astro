---
export const prerender = true;
const pageTitle = "AFAS Live stats";
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;900&family=Inter:wght@400;600&display=swap" rel="stylesheet" />

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      :root {
        --bg: #08080A;
        --bg-card: #131316;
        --text: #F5F5F3;
        --muted: #8A8A90;
        --accent: #00AACC;
        --good: #4CD964;
      }
      html, body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        min-height: 100svh;
        -webkit-font-smoothing: antialiased;
      }
      .gate, .dashboard {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem 1.5rem;
      }
      .gate input {
        background: var(--bg-card);
        border: 1.5px solid rgba(255,255,255,0.1);
        color: var(--text);
        font-size: 1rem;
        padding: 0.9rem 1.1rem;
        border-radius: 6px;
        width: 100%;
        max-width: 300px;
      }
      .gate input:focus { outline: none; border-color: var(--accent); }
      .gate label { color: var(--muted); font-size: 0.9rem; margin-bottom: 0.75rem; }
      .gate button {
        margin-top: 0.85rem;
        background: var(--accent);
        color: white;
        border: none;
        padding: 0.85rem 1.4rem;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
      }
      .gate.hide, .dashboard.hide { display: none; }
      .eyebrow {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 0.95rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 1.25rem;
      }
      .count {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 900;
        font-size: clamp(7rem, 28vw, 16rem);
        line-height: 1;
        color: var(--accent);
        letter-spacing: -0.02em;
        margin-bottom: 1rem;
      }
      .label {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: clamp(1.1rem, 2.5vw, 1.4rem);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        text-align: center;
        margin-bottom: 2.5rem;
      }
      .meta {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--muted);
        font-size: 0.85rem;
      }
      .dot {
        width: 8px; height: 8px; border-radius: 50%;
        background: var(--good);
        box-shadow: 0 0 8px var(--good);
        animation: pulse 1.5s ease-in-out infinite;
      }
      .dot.error { background: #ff4d4d; box-shadow: 0 0 8px #ff4d4d; }
      @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
      .footer {
        margin-top: 2.5rem;
        font-size: 0.8rem;
        color: var(--muted);
      }
      .footer a { color: var(--muted); border-bottom: 1px solid currentColor; text-decoration: none; }
    </style>
  </head>

  <body>
    <main>
      <div class="gate" id="gate">
        <p class="eyebrow">AFAS Live Stats</p>
        <label for="token-input">Voer toegangscode in</label>
        <input type="password" id="token-input" autofocus />
        <button id="gate-btn">Open</button>
      </div>

      <div class="dashboard hide" id="dashboard">
        <p class="eyebrow">Inschrijvingen vanavond</p>
        <div class="count" id="count-display">—</div>
        <p class="label">AFAS Live · Gypsy Kings</p>
        <div class="meta">
          <span class="dot" id="status-dot"></span>
          <span id="meta-text">verbinden...</span>
        </div>
        <div class="footer">
          <a href="https://edstruijlaart.nl/afas" target="_blank">edstruijlaart.nl/afas</a>
        </div>
      </div>
    </main>

    <script is:inline>
      (() => {
        const TOKEN = 'ed-afas-2026';
        const LIST_ID = 43;
        const ENDPOINT = 'https://boeken.edstruijlaart.nl/api/list-count/' + LIST_ID;
        const POLL_MS = 5000;

        const gate = document.getElementById('gate');
        const dashboard = document.getElementById('dashboard');
        const input = document.getElementById('token-input');
        const btn = document.getElementById('gate-btn');
        const countEl = document.getElementById('count-display');
        const dotEl = document.getElementById('status-dot');
        const metaEl = document.getElementById('meta-text');

        function unlock() {
          gate.classList.add('hide');
          dashboard.classList.remove('hide');
          tick();
          setInterval(tick, POLL_MS);
        }

        async function tick() {
          try {
            const r = await fetch(ENDPOINT, { cache: 'no-store' });
            if (!r.ok) throw new Error('HTTP ' + r.status);
            const j = await r.json();
            const n = j.count ?? 0;
            countEl.textContent = String(n);
            const now = new Date().toLocaleTimeString('nl-NL', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            metaEl.textContent = 'live · laatst bijgewerkt ' + now;
            dotEl.classList.remove('error');
          } catch (e) {
            dotEl.classList.add('error');
            metaEl.textContent = 'verbinding verloren, probeer opnieuw';
          }
        }

        const url = new URL(location.href);
        if (url.searchParams.get('key') === TOKEN) {
          unlock();
        } else {
          btn.addEventListener('click', () => {
            if (input.value === TOKEN) {
              const u = new URL(location.href);
              u.searchParams.set('key', TOKEN);
              history.replaceState(null, '', u.toString());
              unlock();
            } else {
              input.value = '';
              input.placeholder = 'fout · probeer opnieuw';
            }
          });
          input.addEventListener('keydown', (e) => { if (e.key === 'Enter') btn.click(); });
        }
      })();
    </script>
  </body>
</html>
