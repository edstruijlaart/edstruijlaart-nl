---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';

const API_BASE = 'https://boeken.edstruijlaart.nl';
const type = Astro.url.searchParams.get('type') || 'algemeen';

const typeConfig: Record<string, { title: string; subtitle: string; slug: string; storageKey: string; ogImage: string }> = {
  gitaarmannen: {
    title: 'Hoe was Gitaarmannen?',
    subtitle: 'Ik ben benieuwd hoe je de theatershow hebt ervaren. Jouw review helpt andere mensen om ook een kaartje te kopen!',
    slug: 'gitaarmannen',
    storageKey: 'review-submitted-gitaarmannen',
    ogImage: '/images/review/og-review-gitaarmannen.jpg'
  },
  huiskamerconcert: {
    title: 'Hoe was het huiskamerconcert?',
    subtitle: 'Ik ben benieuwd hoe je het hebt ervaren. Jouw review helpt andere mensen om ook een huiskamerconcert te boeken. Alvast bedankt!',
    slug: 'huiskamerconcert',
    storageKey: 'review-submitted-huiskamerconcert',
    ogImage: '/images/review/og-review-huiskamerconcert.jpg'
  },
  algemeen: {
    title: 'Hoe was het concert?',
    subtitle: 'Ik ben benieuwd hoe je het hebt ervaren. Jouw review helpt andere mensen om ook te komen. Alvast bedankt!',
    slug: 'algemeen',
    storageKey: 'review-submitted-algemeen',
    ogImage: '/images/review/og-review.jpg'
  }
};

const config = typeConfig[type] || typeConfig.algemeen;
---

<BaseLayout
  title="Laat een review achter"
  description={`${config.title} Laat een review achter voor Ed Struijlaart.`}
  ogImage={config.ogImage}
>
  <section class="py-16 sm:py-24" style="background-color: var(--bg);">
    <div class="mx-auto max-w-[600px] px-4 sm:px-6">

      <!-- Intro -->
      <div class="text-center mb-10">
        <h1 class="font-[var(--font-display)] text-3xl sm:text-4xl text-[var(--fg)] mb-4">
          {config.title}
        </h1>
        <p class="text-[var(--fg-muted)] text-lg leading-relaxed">
          {config.subtitle}
        </p>
      </div>

      <!-- Review form -->
      <div id="review-form-container" class="rounded-xl p-6 sm:p-8" style="background-color: var(--bg-surface); box-shadow: var(--shadow-card);">
        <form id="review-form" class="space-y-5">

          {/* Star rating */}
          <div>
            <label class="block text-sm font-medium text-[var(--fg)] mb-2">
              Hoe beoordeel je het concert?
            </label>
            <div id="star-rating" class="flex gap-1">
              {[1, 2, 3, 4, 5].map(n => (
                <button
                  type="button"
                  data-value={n}
                  class="star-btn text-3xl transition-colors duration-150 text-gray-300 hover:text-[var(--color-gold)]"
                  aria-label={`${n} ster${n > 1 ? 'ren' : ''}`}
                >
                  &#9733;
                </button>
              ))}
            </div>
            <input type="hidden" name="rating" id="rating-input" value="" />
          </div>

          {/* Name */}
          <div>
            <label for="reviewer-name" class="block text-sm font-medium text-[var(--fg)] mb-1">
              Je naam
            </label>
            <input
              type="text"
              id="reviewer-name"
              name="reviewer_name"
              required
              placeholder="Voornaam"
              class="w-full px-4 py-3 rounded-lg border text-[var(--fg)]"
              style="background-color: var(--bg); border-color: var(--fg-muted);"
            />
          </div>

          {/* City */}
          <div>
            <label for="reviewer-city" class="block text-sm font-medium text-[var(--fg)] mb-1">
              Woonplaats <span class="text-[var(--fg-muted)] font-normal">(optioneel)</span>
            </label>
            <input
              type="text"
              id="reviewer-city"
              name="reviewer_city"
              placeholder="bijv. Amsterdam"
              class="w-full px-4 py-3 rounded-lg border text-[var(--fg)]"
              style="background-color: var(--bg); border-color: var(--fg-muted);"
            />
          </div>

          {/* Review text */}
          <div>
            <label for="review-text" class="block text-sm font-medium text-[var(--fg)] mb-1">
              Je review <span class="text-[var(--fg-muted)] font-normal">(optioneel)</span>
            </label>
            <textarea
              id="review-text"
              name="review_text"
              rows="4"
              maxlength="500"
              placeholder="Vertel hoe je het concert hebt ervaren..."
              class="w-full px-4 py-3 rounded-lg border text-[var(--fg)]"
              style="background-color: var(--bg); border-color: var(--fg-muted);"
            ></textarea>
          </div>

          {/* Email (optional) */}
          <div>
            <label for="reviewer-email" class="block text-sm font-medium text-[var(--fg)] mb-1">
              E-mailadres <span class="text-[var(--fg-muted)] font-normal">(optioneel)</span>
            </label>
            <input
              type="email"
              id="reviewer-email"
              name="reviewer_email"
              placeholder="je@email.nl"
              class="w-full px-4 py-3 rounded-lg border text-[var(--fg)]"
              style="background-color: var(--bg); border-color: var(--fg-muted);"
            />
          </div>

          {/* Newsletter opt-in */}
          <div class="flex items-start gap-3">
            <input
              type="checkbox"
              id="subscribe-checkbox"
              name="subscribe"
              class="mt-1 h-4 w-4 rounded border-gray-300 accent-[var(--color-gold)]"
            />
            <label for="subscribe-checkbox" class="text-sm text-[var(--fg-muted)] leading-snug">
              Ja, ik wil af en toe updates ontvangen over concerten en nieuwe muziek van Ed.
            </label>
          </div>

          {/* Error / submit */}
          <p id="review-error" class="text-red-500 text-sm hidden"></p>

          <button
            type="submit"
            id="review-submit"
            class="w-full px-6 py-3 rounded-full text-white font-medium transition-colors duration-300"
            style="background-color: var(--color-gold);"
          >
            Verstuur review
          </button>
        </form>
      </div>

      {/* Success state */}
      <div id="review-success" class="text-center py-8 hidden">
        <p class="text-lg text-[var(--fg)] mb-2">Bedankt voor je review!</p>
        <p class="text-[var(--fg-muted)]">Je review wordt binnenkort zichtbaar na goedkeuring.</p>
      </div>

    </div>
  </section>
</BaseLayout>

<script define:vars={{ API_BASE, slug: config.slug, storageKey: config.storageKey }}>
  // Star rating logic
  const starBtns = document.querySelectorAll('.star-btn');
  const ratingInput = document.getElementById('rating-input');
  let selectedRating = 0;

  starBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      selectedRating = parseInt(btn.dataset.value);
      ratingInput.value = selectedRating;
      starBtns.forEach(s => {
        const val = parseInt(s.dataset.value);
        s.style.color = val <= selectedRating ? 'var(--color-gold)' : '';
        s.classList.toggle('text-gray-300', val > selectedRating);
      });
    });

    btn.addEventListener('mouseenter', () => {
      const hoverVal = parseInt(btn.dataset.value);
      starBtns.forEach(s => {
        const val = parseInt(s.dataset.value);
        s.style.color = val <= hoverVal ? 'var(--color-gold)' : '';
      });
    });
  });

  const starContainer = document.getElementById('star-rating');
  if (starContainer) {
    starContainer.addEventListener('mouseleave', () => {
      starBtns.forEach(s => {
        const val = parseInt(s.dataset.value);
        s.style.color = val <= selectedRating ? 'var(--color-gold)' : '';
        s.classList.toggle('text-gray-300', val > selectedRating);
      });
    });
  }

  // Form submit
  const form = document.getElementById('review-form');
  const errorEl = document.getElementById('review-error');
  const successEl = document.getElementById('review-success');
  const formContainer = document.getElementById('review-form-container');

  // Check if already submitted
  const submitted = localStorage.getItem(storageKey);
  if (submitted && formContainer && successEl) {
    formContainer.classList.add('hidden');
    successEl.classList.remove('hidden');
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');

      if (!selectedRating) {
        errorEl.textContent = 'Geef een beoordeling met sterren';
        errorEl.classList.remove('hidden');
        return;
      }

      const name = form.querySelector('[name="reviewer_name"]').value.trim();
      if (!name) {
        errorEl.textContent = 'Vul je naam in';
        errorEl.classList.remove('hidden');
        return;
      }

      const btn = document.getElementById('review-submit');
      btn.disabled = true;
      btn.textContent = 'Even geduld...';

      try {
        const res = await fetch(`${API_BASE}/api/review/submit-by-slug/${slug}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            reviewer_name: name,
            reviewer_city: form.querySelector('[name="reviewer_city"]').value.trim() || null,
            rating: selectedRating,
            review_text: form.querySelector('[name="review_text"]').value.trim() || null,
            concert_date: null,
            email: form.querySelector('[name="reviewer_email"]').value.trim() || null,
            subscribe: form.querySelector('[name="subscribe"]').checked || false
          })
        });

        if (!res.ok) {
          const result = await res.json();
          throw new Error(result.detail || 'Er ging iets mis');
        }

        localStorage.setItem(storageKey, 'true');
        formContainer.classList.add('hidden');
        successEl.classList.remove('hidden');
      } catch (err) {
        errorEl.textContent = err.message;
        errorEl.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Verstuur review';
      }
    });
  }
</script>
