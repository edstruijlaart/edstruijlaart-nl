---
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return [
    { params: { slug: 'closer-than-skin' }, props: { redirectTo: '/music/#closer-than-skin' } },
    { params: { slug: 'head-heart-hands' }, props: { redirectTo: '/music/#head-heart-hands' } },
    { params: { slug: 'what-i-like-about-you' }, props: { redirectTo: '/music/' } },
  ];
};

const { redirectTo } = Astro.props;

return Astro.redirect(redirectTo, 301);
---
