---
export const prerender = false;

// Beveiligde inzage in de Continuum Day-aanmeldingen (alleen Ed).
// Beveiliging is SERVER-SIDE (anders dan afas-stats, waar alleen een teller
// achter zit): in de repo staat uitsluitend een SHA-256-hash van de
// toegangscode (repo is public; de code zelf is 80+ bits random en staat
// nergens in code of env). De code komt binnen via POST (nooit in de URL),
// wordt na succes in een HttpOnly-cookie bewaard, en de deelnemerdata wordt
// pas na een geslaagde check server-side uit Sanity gehaald.
import { createHash, timingSafeEqual } from "node:crypto";
import { sanityWriteClient } from "../lib/sanity";
import { PUBLIEK_MAX, INTERN_MAX } from "../lib/continuum-day-capaciteit";
import { TV_STATUSSEN, type TvStatus } from "../lib/continuum-day-tv";

const CODE_HASH = "aa197d639aa233182695cc51b205168ce68add6f7362c92d87f3f9685fa5b9ef";
const COOKIE = "cd_admin";

function checkCode(raw: string | null | undefined): string | null {
  if (!raw) return null;
  const code = raw.trim().toUpperCase();
  if (code.length < 20 || code.length > 40) return null;
  const h = createHash("sha256").update(code).digest();
  const expected = Buffer.from(CODE_HASH, "hex");
  if (h.length === expected.length && timingSafeEqual(h, expected)) return code;
  return null;
}

let authorized = false;
let foutmelding = "";

const cookieCode = Astro.cookies.get(COOKIE)?.value;
if (checkCode(cookieCode)) authorized = true;

// formData kan maar één keer gelezen worden; zowel de code-check als de
// tv-statusknoppen komen via POST binnen.
const postForm = Astro.request.method === "POST" ? await Astro.request.formData().catch(() => null) : null;

if (!authorized && postForm) {
  const form = postForm;
  const code = checkCode(String(form?.get("code") ?? ""));
  if (code) {
    authorized = true;
    Astro.cookies.set(COOKIE, code, {
      httpOnly: true,
      secure: true,
      sameSite: "lax",
      path: "/continuum-day-aanmeldingen",
      maxAge: 60 * 60 * 24 * 60,
    });
  } else {
    foutmelding = "Onjuiste code.";
  }
}

// Tijd voor Max: Ed zet per kandidaat een status. Alleen na auth, alleen via POST,
// alleen bekende statussen, alleen op ID's die eruitzien als een aanmeld-document.
if (authorized && postForm?.get("actie") === "tvstatus") {
  const id = String(postForm.get("id") ?? "");
  const status = String(postForm.get("status") ?? "") as TvStatus;
  if (/^continuumDayAanmelding\.[A-Za-z0-9._@+-]{3,120}$/.test(id) && (TV_STATUSSEN as readonly string[]).includes(status)) {
    await sanityWriteClient.patch(id).set({ "tvKandidaat.status": status }).commit();
  }
}

interface TvKandidaat {
  beschikbaar: string; woonplaats: string; jaren: string; publiek: string;
  verhaal: string; video: string; telefoon: string; ingevuldOp: string; status: TvStatus;
}
interface TvRij { _id: string; naam: string; leeftijd: number; email: string; land?: string; tvKandidaat: TvKandidaat; }
let tvKandidaten: TvRij[] = [];

interface Aanmelding {
  naam: string;
  leeftijd: number;
  email: string;
  aangemeldOp: string;
  wachtlijst?: boolean;
  land?: string;
}

let aanmeldingen: Aanmelding[] = [];
let jongste: Aanmelding | null = null;
let oudste: Aanmelding | null = null;
let spelersCount = 0;
let pct = 0;
let publiekGetoond = 0;
let ruimte = 0;
let opkomstLaag = 0;
let opkomstHoog = 0;
let gemiddeldeLeeftijd: number | null = null;

if (authorized) {
  tvKandidaten = await sanityWriteClient.fetch(
    `*[_type == "continuumDayAanmelding" && defined(tvKandidaat)] | order(tvKandidaat.ingevuldOp desc){_id, naam, leeftijd, email, land, tvKandidaat}`
  );
  aanmeldingen = await sanityWriteClient.fetch(
    `*[_type == "continuumDayAanmelding"] | order(aangemeldOp desc){naam, leeftijd, email, aangemeldOp, wachtlijst, land}`
  );
  for (const a of aanmeldingen) {
    if (typeof a.leeftijd !== "number") continue;
    if (!jongste || a.leeftijd < jongste.leeftijd) jongste = a;
    if (!oudste || a.leeftijd > oudste.leeftijd) oudste = a;
  }
  spelersCount = aanmeldingen.filter((a) => !a.wachtlijst).length;
  pct = Math.round((spelersCount / INTERN_MAX) * 100);
  publiekGetoond = Math.min(spelersCount, PUBLIEK_MAX);
  ruimte = Math.max(INTERN_MAX - spelersCount, 0);
  // Grove opkomstschatting. Geen meetcijfer van dit event, maar bij een gratis
  // buitenevent haakt een fors deel af zonder zich af te melden. Deze range is
  // waar het om draait: hoeveel gitaristen staan er straks echt op het plein.
  opkomstLaag = Math.round(spelersCount * 0.65);
  opkomstHoog = Math.round(spelersCount * 0.85);
  const leeftijden = aanmeldingen.map((a) => a.leeftijd).filter((l): l is number => typeof l === "number");
  if (leeftijden.length) {
    gemiddeldeLeeftijd = Math.round((leeftijden.reduce((s, l) => s + l, 0) / leeftijden.length) * 10) / 10;
  }
}

const LBL: Record<string, string> = {
  ja: "Ja", misschien: "Misschien", nee: "Nee",
  "<2": "< 2 jr", "2-5": "2–5 jr", "5-10": "5–10 jr", "10+": "10+ jr",
  nooit: "nooit", soms: "af en toe", regelmatig: "regelmatig",
  kandidaat: "—", gekozen: "Gekozen", reserve: "Reserve",
};
const tvTel = (st: TvStatus) => tvKandidaten.filter((k) => k.tvKandidaat.status === st).length;
const tvBeschikbaar = tvKandidaten.filter((k) => k.tvKandidaat.beschikbaar === "ja").length;

function fmt(iso: string): string {
  try {
    return new Date(iso).toLocaleString("nl-NL", {
      timeZone: "Europe/Amsterdam",
      day: "numeric",
      month: "short",
      hour: "2-digit",
      minute: "2-digit",
    });
  } catch {
    return iso;
  }
}

Astro.response.headers.set("Cache-Control", "no-store");
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Continuum Day · aanmeldingen</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;900&family=Inter:wght@400;600&display=swap" rel="stylesheet" />
    <style>
      /* Gescoped onder .cd-page, zelfde reden als afas-stats: geen html/body/:root
         selectors gebruiken, anders lekt dit site-breed via de gedeelde bundle. */
      .cd-page, .cd-page *, .cd-page *::before, .cd-page *::after { box-sizing: border-box; margin: 0; padding: 0; }
      .cd-page {
        --bg: #08080A; --card: #131316; --text: #F5F5F3; --muted: #8A8A90;
        --accent: #00AACC; --border: rgba(255,255,255,0.08);
        min-height: 100svh; background: var(--bg); color: var(--text);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        -webkit-font-smoothing: antialiased;
        display: flex; flex-direction: column; align-items: center;
        padding: 2.5rem 1.25rem 4rem;
      }
      .eyebrow {
        font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 0.95rem;
        letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-bottom: 1rem;
      }
      .gate { min-height: 70svh; display: flex; flex-direction: column; align-items: center; justify-content: center; }
      .gate label { color: var(--muted); font-size: 0.9rem; margin-bottom: 0.75rem; }
      .gate input {
        background: var(--card); border: 1.5px solid var(--border); color: var(--text);
        font-size: 1rem; padding: 0.9rem 1.1rem; border-radius: 6px; width: 100%; max-width: 320px;
        text-transform: uppercase;
      }
      .gate input:focus { outline: none; border-color: var(--accent); }
      .gate button {
        margin-top: 0.85rem; background: var(--accent); color: white; border: none;
        padding: 0.85rem 1.4rem; border-radius: 6px; font-size: 1rem; font-weight: 600; cursor: pointer;
      }
      .fout { color: #ff6b6b; font-size: 0.9rem; margin-top: 0.8rem; }
      .stats { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-bottom: 2rem; }
      .stat {
        background: var(--card); border: 1px solid var(--border); border-radius: 8px;
        padding: 1rem 1.4rem; text-align: center; min-width: 130px;
      }
      .stat .n {
        font-family: 'Barlow Condensed', sans-serif; font-weight: 900;
        font-size: 2.4rem; line-height: 1; color: var(--accent);
      }
      .stat .l { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; margin-top: 0.4rem; }
      .stat .sub { font-size: 0.8rem; color: var(--text); margin-top: 0.2rem; }
      /* De lijst is lang (250+ regels), dus leesbaarheid gaat hier boven compactheid:
         ruime kolommen zodat niets afbreekt, één regel per persoon, en een header
         die blijft staan tijdens het scrollen. */
      .tabel-wrap {
        width: 100%; max-width: 1180px; overflow-x: auto;
        background: var(--card); border: 1px solid var(--border); border-radius: 10px;
      }
      /* Alles onder .tabel-wrap: de reset hierboven wordt door Astro vertaald naar
         twee attribuutselectors en weegt daardoor zwaarder dan een kale td-regel.
         Met .tabel-wrap ervoor winnen deze regels wel en houdt de padding stand. */
      .tabel-wrap table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
      .tabel-wrap th {
        font-family: 'Barlow Condensed', sans-serif; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.08em; font-size: 0.8rem; color: var(--muted); text-align: left;
        padding: 0.75rem 1rem; border-bottom: 1px solid var(--border);
        position: sticky; top: 0; z-index: 1; background: #191920; white-space: nowrap;
      }
      .tabel-wrap td {
        padding: 0.6rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.05);
        vertical-align: middle; white-space: nowrap;
      }
      .tabel-wrap tbody tr:last-child td { border-bottom: none; }
      .tabel-wrap tbody tr:nth-child(even) { background: rgba(255,255,255,0.022); }
      .tabel-wrap tbody tr:hover { background: rgba(0,170,204,0.09); }
      /* Volgnummer en leeftijd rechts uitlijnen zodat 9, 99 en 261 onder elkaar staan. */
      .tabel-wrap td.tel, .tabel-wrap th.tel {
        text-align: right; color: var(--muted); font-variant-numeric: tabular-nums;
      }
      .tabel-wrap td.num { color: var(--muted); font-variant-numeric: tabular-nums; }
      .tabel-wrap td.naam { font-weight: 500; color: var(--text); }
      .tabel-wrap td.email { color: var(--muted); }
      .tabel-wrap td.leeftijd, .tabel-wrap th.leeftijd { text-align: right; }
      /* De naamkolom mag de resterende ruimte opslokken, de rest blijft compact. */
      .tabel-wrap td.naam, .tabel-wrap th:nth-child(2) { width: 100%; }
      /* Tijd voor Max-blok: eigen kaart boven de grote lijst, deze week het belangrijkste. */
      .tv { width: 100%; max-width: 1180px; margin-bottom: 2.5rem; }
      .tv .tv-kop {
        display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.8rem;
        font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 1.5rem;
        text-transform: uppercase; letter-spacing: 0.04em;
      }
      .tv .tv-kop .tv-sub { font-family: 'Inter', sans-serif; font-weight: 400; font-size: 0.85rem; color: var(--muted); text-transform: none; letter-spacing: 0; }
      .tv .tv-kop .tv-sub b { color: var(--accent); font-weight: 600; }
      .tv .tabel-wrap td.verhaal { white-space: normal; min-width: 260px; max-width: 380px; font-size: 0.84rem; color: var(--text); line-height: 1.4; }
      .tv .tabel-wrap td.ja { color: #5ad18a; font-weight: 600; }
      .tv .tabel-wrap td.nee { color: #ff6b6b; }
      .tv .tabel-wrap td.mis { color: #e0a93a; }
      .tv .tabel-wrap tbody tr.st-gekozen { background: rgba(90,209,138,0.10); }
      .tv .tabel-wrap tbody tr.st-reserve { background: rgba(224,169,58,0.10); }
      .tv .tabel-wrap tbody tr.st-nee td { opacity: 0.4; }
      .tv .tabel-wrap tbody tr.st-nee td.acties { opacity: 1; }
      .tv .tabel-wrap td.acties form { display: flex; gap: 0.3rem; }
      .tv .tabel-wrap td.acties button {
        font: inherit; font-size: 0.75rem; font-weight: 600; padding: 0.3rem 0.55rem; border-radius: 5px;
        border: 1px solid var(--border); background: transparent; color: var(--muted); cursor: pointer;
      }
      .tv .tabel-wrap td.acties button:hover { border-color: var(--accent); color: var(--text); }
      .tv .tabel-wrap td.acties button.actief-gekozen { background: #5ad18a; color: #08080A; border-color: #5ad18a; }
      .tv .tabel-wrap td.acties button.actief-reserve { background: #e0a93a; color: #08080A; border-color: #e0a93a; }
      .tv .tabel-wrap td.acties button.actief-nee { background: #ff6b6b; color: #08080A; border-color: #ff6b6b; }
      .tv .tabel-wrap a { color: var(--accent); }
      .tv .leeg-tv { color: var(--muted); font-size: 0.9rem; padding: 1rem 1.2rem; background: var(--card); border: 1px solid var(--border); border-radius: 10px; }
      .badge {
        display: inline-block; margin-left: 0.5rem; padding: 0.1rem 0.4rem; border-radius: 4px;
        background: rgba(224,169,58,0.15); color: #e0a93a; font-size: 0.7rem;
        text-transform: uppercase; letter-spacing: 0.06em; vertical-align: middle;
      }
      .leeg { color: var(--muted); margin-top: 2rem; }
      .avg-noot { margin-top: 2.5rem; font-size: 0.78rem; color: var(--muted); max-width: 620px; text-align: center; }
    </style>
  </head>

  <body style="margin:0; background:#08080A;">
    <main class="cd-page">
      {!authorized ? (
        <form class="gate" method="post" autocomplete="off">
          <p class="eyebrow">Continuum Day · aanmeldingen</p>
          <label for="code">Voer toegangscode in</label>
          <input type="password" id="code" name="code" autofocus autocapitalize="characters" />
          <button type="submit">Open</button>
          {foutmelding && <p class="fout">{foutmelding}</p>}
        </form>
      ) : (
        <>
          <p class="eyebrow">Continuum Day · za 12 september 2026</p>
          <div class="stats">
            <div class="stat">
              <div class="n">{spelersCount}</div>
              <div class="l">spelers, echt</div>
              <div class="sub">intern plafond {INTERN_MAX}</div>
            </div>
            <div class="stat">
              <div class="n">{publiekGetoond}</div>
              <div class="l">publiek getoond</div>
              <div class="sub">{spelersCount >= PUBLIEK_MAX ? "site zegt VOL" : `van de ${PUBLIEK_MAX}`}</div>
            </div>
            <div class="stat">
              <div class="n">{ruimte}</div>
              <div class="l">nog toe te laten</div>
              <div class="sub">tot {INTERN_MAX}</div>
            </div>
            <div class="stat">
              <div class="n">{opkomstLaag}&ndash;{opkomstHoog}</div>
              <div class="l">verwachte opkomst</div>
              <div class="sub">schatting, 15&ndash;35% no-show</div>
            </div>
            <div class="stat">
              <div class="n">{pct}%</div>
              <div class="l">van intern plafond</div>
            </div>
            {gemiddeldeLeeftijd !== null && (
              <div class="stat">
                <div class="n">{gemiddeldeLeeftijd}</div>
                <div class="l">gem. leeftijd</div>
              </div>
            )}
            {aanmeldingen.some((a) => a.wachtlijst) && (
              <div class="stat">
                <div class="n">{aanmeldingen.filter((a) => a.wachtlijst).length}</div>
                <div class="l">wachtlijst</div>
              </div>
            )}
            {jongste && (
              <div class="stat">
                <div class="n">{jongste.leeftijd}</div>
                <div class="l">jongste</div>
                <div class="sub">{jongste.naam}</div>
              </div>
            )}
            {oudste && (
              <div class="stat">
                <div class="n">{oudste.leeftijd}</div>
                <div class="l">oudste</div>
                <div class="sub">{oudste.naam}</div>
              </div>
            )}
          </div>

          <section class="tv">
            <h2 class="tv-kop">
              Tijd voor Max · do 10 sep
              <span class="tv-sub"><b>{tvKandidaten.length}</b> reacties · <b>{tvBeschikbaar}</b> beschikbaar · <b>{tvTel("gekozen")}</b> gekozen · <b>{tvTel("reserve")}</b> reserve</span>
            </h2>
            {tvKandidaten.length === 0 ? (
              <p class="leeg-tv">Nog geen reacties op de oproep. Zodra iemand het formulier invult, verschijnt hij hier.</p>
            ) : (
              <div class="tabel-wrap">
                <table>
                  <thead>
                    <tr><th>Naam</th><th class="leeftijd">Lft</th><th>Woont</th><th>10 sep</th><th>Speelt</th><th>Publiek</th><th>Verhaal</th><th>Film</th><th>Tel</th><th>Keuze</th></tr>
                  </thead>
                  <tbody>
                    {tvKandidaten.map((k) => {
                      const t = k.tvKandidaat;
                      const bClass = t.beschikbaar === "ja" ? "ja" : t.beschikbaar === "nee" ? "nee" : "mis";
                      return (
                        <tr class={`st-${t.status}`}>
                          <td class="naam">{k.naam}</td>
                          <td class="leeftijd">{k.leeftijd}</td>
                          <td>{t.woonplaats}</td>
                          <td class={bClass}>{LBL[t.beschikbaar] ?? t.beschikbaar}</td>
                          <td class="num">{LBL[t.jaren] ?? t.jaren}</td>
                          <td class="num">{LBL[t.publiek] ?? t.publiek}</td>
                          <td class="verhaal">{t.verhaal || <span style="color:var(--muted)">—</span>}</td>
                          <td>{t.video ? <a href={t.video} target="_blank" rel="noopener noreferrer">bekijk</a> : <span style="color:var(--muted)">—</span>}</td>
                          <td class="num">{t.telefoon || "—"}</td>
                          <td class="acties">
                            <form method="post">
                              <input type="hidden" name="actie" value="tvstatus" />
                              <input type="hidden" name="id" value={k._id} />
                              <button type="submit" name="status" value="gekozen" class={t.status === "gekozen" ? "actief-gekozen" : ""} title="Gekozen">✓</button>
                              <button type="submit" name="status" value="reserve" class={t.status === "reserve" ? "actief-reserve" : ""} title="Reserve">R</button>
                              <button type="submit" name="status" value="nee" class={t.status === "nee" ? "actief-nee" : ""} title="Niet">✕</button>
                              {t.status !== "kandidaat" && <button type="submit" name="status" value="kandidaat" title="Terug naar open">↺</button>}
                            </form>
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            )}
          </section>

          {aanmeldingen.length === 0 ? (
            <p class="leeg">Nog geen aanmeldingen.</p>
          ) : (
            <div class="tabel-wrap">
              <table>
                <thead>
                  <tr><th class="tel">#</th><th>Naam</th><th class="leeftijd">Lft</th><th>E-mail</th><th class="land">Land</th><th>Aangemeld</th></tr>
                </thead>
                <tbody>
                  {aanmeldingen.map((a, i) => (
                    <tr>
                      <td class="tel">{aanmeldingen.length - i}</td>
                      <td class="naam">{a.naam}{a.wachtlijst && <span class="badge">wachtlijst</span>}</td>
                      <td class="leeftijd">{a.leeftijd}</td>
                      <td class="email">{a.email}</td>
                      <td class="num land" style={["NL", "BE", "LU"].includes(a.land ?? "") ? "" : "color:#e0a93a;"}>{a.land ?? "—"}</td>
                      <td class="num">{fmt(a.aangemeldOp)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          <p class="avg-noot">Persoonsgegevens van deelnemers. Alleen voor de organisatie van Continuum Day; niet delen, niet exporteren naar derden. Uiterlijk drie maanden na het evenement verwijderen (staat zo in de deelnamevoorwaarden).</p>
        </>
      )}
    </main>
  </body>
</html>
