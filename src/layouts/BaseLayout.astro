---
import '@fontsource/barlow-condensed/400.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '../styles/global.css';

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { getLocaleFromUrl, useTranslations, getPathWithoutLocale } from '../i18n/utils';
import { localeHtmlLang, localeOgTag, getAlternateUrls, defaultLocale } from '../i18n/config';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article' | 'profile';
  noIndex?: boolean;
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const {
  title,
  description = t.meta.siteDescription,
  ogImage = '/og-image.jpg',
  type = 'website',
  noIndex = false,
} = Astro.props;

const siteTitle = title === 'Home'
  ? t.meta.homeTitle
  : `${title} | ${t.meta.titleSuffix}`;

const canonicalUrl = Astro.url.href;
const htmlLang = localeHtmlLang[locale];
const ogLocale = localeOgTag[locale];
const pathWithoutLocale = getPathWithoutLocale(Astro.url.pathname);
const alternates = getAlternateUrls(pathWithoutLocale, Astro.site?.toString() || 'https://edstruijlaart.nl');
---

<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-site-verification" content="C0Zpxgo4u1JDUzp92SXGlVi2ZHTZbbqL_cQAo1MfFCs" />

  <title>{siteTitle}</title>
  <meta name="description" content={description} />
  {noIndex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalUrl} />

  <!-- hreflang: tell search engines about all language versions -->
  {alternates.map(alt => (
    <link rel="alternate" hreflang={alt.locale === defaultLocale ? 'nl' : alt.locale} href={alt.href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={alternates.find(a => a.locale === 'en')?.href} />

  <!-- Open Graph -->
  <meta property="og:title" content={siteTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={type} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:site_name" content="Ed Struijlaart" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={siteTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Dark mode: voorkom flash - default is light, dark alleen als expliciet gekozen -->
  <script is:inline>
    (function() {
      const stored = localStorage.getItem('theme');
      if (stored === 'dark') {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>

  <!-- JSON-LD: Person + MusicGroup -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Ed Struijlaart",
    "url": "https://edstruijlaart.nl",
    "jobTitle": "Singer-songwriter, Theatermaker, Podcastmaker",
    "email": "ed@earswantmusic.nl",
    "description": "Nederlandse singer-songwriter, theatermaker en podcastmaker. Bekend van Gitaarmannen, NPO Radio 2 Topsongs en Make It On Your Own (26M+ streams).",
    "knowsAbout": ["Muziek", "Gitaar", "Theater", "Podcast"],
    "sameAs": [
      "https://open.spotify.com/artist/08cpwYrPWo8Xkxl9qdiDP2",
      "https://youtube.com/@edstruijlaart",
      "https://instagram.com/edstruijlaart",
      "https://facebook.com/edstruijlaartofficial",
      "https://tiktok.com/@edstruijlaart_zelf"
    ]
  })} />

  <!-- JSON-LD: BreadcrumbList -->
  {title !== 'Home' && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://edstruijlaart.nl" },
        { "@type": "ListItem", "position": 2, "name": title, "item": canonicalUrl }
      ]
    })} />
  )}

  <!-- Umami Analytics (self-hosted) -->
  <script defer src="https://analytics.earswantmusic.nl/script.js" data-website-id="98cc05e1-4825-4c78-a94a-e823227f0cc3"></script>

  <!-- Page-specific head content (JSON-LD etc.) -->
  <slot name="head" />
</head>
<body class="min-h-screen flex flex-col">
  <a href="#main-content" class="skip-link">{t.layout.skipToContent}</a>
  <Header />
  <main id="main-content" class="flex-1">
    <slot />
  </main>
  <Footer />
</body>
</html>
